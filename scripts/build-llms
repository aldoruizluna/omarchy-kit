#!/usr/bin/env python3
"""build-llms: write llms-full.txt, the whole documentation in one file, from the documents that llms.txt links to.

  scripts/build-llms           regenerate llms-full.txt
  scripts/build-llms --check   exit 1 if llms-full.txt is out of date (the tests use this); writes nothing
  scripts/build-llms --list    print the files that go into it

llms.txt is the hand-written index. Every link in it that points into this repository becomes a section of llms-full.txt, in the order
it appears, except links under a heading called "Optional" (those are for tools that have room to spare). Run it after any documentation change.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RAW = "https://raw.githubusercontent.com/aldoruizluna/omarchy-kit/main/"
LINK = re.compile(r"^- \[([^\]]+)\]\(([^)]+)\)")


def sections(text):
    """(heading, [(title, url)]) pairs in order, from llms.txt."""
    out, cur = [], None
    for line in text.splitlines():
        if line.startswith("## "):
            cur = (line[3:].strip(), [])
            out.append(cur)
        elif cur is not None and (m := LINK.match(line)):
            cur[1].append((m[1], m[2]))
    return out


def files(include_optional=False):
    seen, out = set(), []
    for heading, links in sections((ROOT / "llms.txt").read_text()):
        if heading.lower() == "optional" and not include_optional:
            continue
        for title, url in links:
            if url.startswith(RAW):
                rel = url[len(RAW):]
                if rel not in seen:
                    seen.add(rel)
                    out.append((title, rel))
    return out


def render():
    head = (ROOT / "llms.txt").read_text().split("\n## ", 1)[0].rstrip()
    parts = [head.replace("# Omarchy Kit", "# Omarchy Kit: full documentation", 1), "",
             "> Generated by scripts/build-llms from the documents listed in llms.txt (without its Optional section). Do not edit: edit the sources and regenerate.", ""]
    for title, rel in files():
        body = (ROOT / rel).read_text().rstrip("\n")
        parts += ["", "=" * 100, f"FILE: {rel}  ({title})", "=" * 100, "", body, ""]
    return "\n".join(parts).rstrip("\n") + "\n"


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    if argv and argv[0] not in ("--check", "--list") or len(argv) > 1:
        print("usage: build-llms [--check | --list]   (--help for details)", file=sys.stderr)
        return 2
    if argv == ["--list"]:
        for title, rel in files():
            print(rel)
        return 0
    text = render()
    target = ROOT / "llms-full.txt"
    if argv == ["--check"]:
        current = target.read_text() if target.exists() else ""
        if current != text:
            print("llms-full.txt is out of date: run scripts/build-llms", file=sys.stderr)
            return 1
        return 0
    target.write_text(text)
    print(f"wrote llms-full.txt: {len(files())} documents, {len(text.splitlines())} lines, {len(text) // 1024} KB")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
