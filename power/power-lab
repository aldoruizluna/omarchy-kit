#!/usr/bin/env python3
"""power-lab: measure where a laptop's battery power goes, and test power-saving changes safely.

  power-lab quiet         your battery draw at normal brightness and with the backlight off          (about 2 minutes)
  power-lab breakdown     adds CPU-package power (RAPL) and how deeply the CPU package sleeps (PC2..PC7),
                          with the display on and then switched off                                  (about 3 minutes)
  power-lab singles       tries seven single changes one at a time (each is reverted straight after)   (about 9 minutes)
  power-lab stack         applies the candidate fixes cumulatively, then removes them one by one     (about 9 minutes)
  power-lab hunt          looks for what keeps the CPU package out of deep sleep (PC6/PC7): turns on PCIe link power saving on the
                          links that have it off, one group at a time. Works on the charger too                               (about 3 minutes)
  power-lab results [mode]   show the last results (any mode name, or all of them)
  power-lab <mode> --check   look only: show what it detected on this machine, change nothing

Run it as yourself. It asks for sudo once and runs the test as a background system service, so this terminal stays idle: a busy
terminal repaints the screen and adds about 4 W by itself, which would spoil the numbers. During a test keep your hands off the
keyboard and trackpad (input wakes the display), and keep the charger unplugged: the draw is read from the battery.

Nothing is permanent. Every change is reverted right after its measurement, and also on any exit or signal; the backlight and the
display are restored at the end. Results are written to data/power-lab/<mode>.txt (git-ignored).
Written for this MacBookPro11,3 (Haswell, Hyprland, apple-gmux backlight); machine-specific bits are detected, not hard-coded."""
import argparse, atexit, glob, os, pwd, shlex, signal, statistics, struct, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_OUT = os.path.join(os.path.dirname(HERE), "data", "power-lab")
MODES = {"quiet": "about 2 minutes", "breakdown": "about 3 minutes", "singles": "about 9 minutes", "stack": "about 9 minutes", "hunt": "about 3 minutes"}
PC_MSRS = {"PC2": 0x60D, "PC3": 0x3F8, "PC6": 0x3F9, "PC7": 0x3FA}   # Haswell package C-state residency counters


def first(paths):
    return sorted(paths)[0] if paths else ""


def rd(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return ""


def wr(p, v):
    try:
        open(p, "w").write(str(v))
        return True
    except OSError:
        return False


def sh(*cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        return (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


class Lab:
    def __init__(self, user, sig, out):
        self.user, self.sig, self.out = user, sig, out
        self.lines, self.undo, self.saved, self.name = [], [], {}, "lab"
        self.bat = first(glob.glob("/sys/class/power_supply/BAT*"))
        self.ac = [p for p in glob.glob("/sys/class/power_supply/*/online") if rd(os.path.dirname(p) + "/type") == "Mains"]
        bl = glob.glob("/sys/class/backlight/*")
        self.backlight = os.path.basename(first([b for b in bl if "gmux" in b or "intel" in b] or bl)) if bl else ""
        wl = sorted(os.path.dirname(p) for p in glob.glob("/sys/class/net/*/wireless"))
        self.wifi = os.path.basename(wl[0]) if wl else ""
        self.rapl = {rd(d + "/name"): d + "/energy_uj" for d in sorted(glob.glob("/sys/class/powercap/intel-rapl:*"))}
        self.msr = None
        lspci = sh("lspci", "-D")
        self.camera = [l.split()[0] for l in lspci.splitlines() if "FaceTime" in l]
        self.thunderbolt = [l.split()[0] for l in lspci.splitlines() if "Thunderbolt" in l]
        self.orig_brightness = sh("brightnessctl", "-d", self.backlight, "get") if self.backlight else ""

    # --- output ---------------------------------------------------------------------------------------------------------------
    def say(self, msg=""):
        print(msg, flush=True)
        self.lines.append(msg)
        os.makedirs(self.out, exist_ok=True)
        with open(os.path.join(self.out, self.name + ".txt"), "w") as f:
            f.write("\n".join(self.lines) + "\n")
            f.flush()
            os.fsync(f.fileno())

    # --- environment ----------------------------------------------------------------------------------------------------------
    def hypr(self, *a):
        return sh("runuser", "-u", self.user, "--", "env", "XDG_RUNTIME_DIR=/run/user/%d" % pwd.getpwnam(self.user).pw_uid,
                  f"HYPRLAND_INSTANCE_SIGNATURE={self.sig}", "hyprctl", *a)

    def dpms(self, action):   # only "enable" / "disable": this Hyprland treats other words as a toggle
        return self.hypr("dispatch", f'hl.dsp.dpms({{ action = "{action}" }})')

    def dpms_state(self):
        for l in self.hypr("monitors").splitlines():
            if "dpmsStatus" in l:
                return l.split(":")[1].strip()
        return "?"

    def on_battery(self):
        return not any(rd(p) == "1" for p in self.ac)

    def set_backlight(self, v):
        sh("brightnessctl", "-d", self.backlight, "set", str(v))

    def restore_all(self, *_):
        while self.undo:
            name, rev = self.undo.pop()
            try:
                rev()
            except Exception as e:
                self.say(f"   undo error in {name}: {e}")
        if self.sig:
            self.dpms("enable")
        if self.backlight and self.orig_brightness:
            self.set_backlight(self.orig_brightness)

    def open_msr(self):
        try:
            self.msr = os.open("/dev/cpu/0/msr", os.O_RDONLY)
        except OSError:
            self.msr = None

    # --- measuring ------------------------------------------------------------------------------------------------------------
    def watts(self):
        return int(rd(self.bat + "/current_now")) * int(rd(self.bat + "/voltage_now")) / 1e12

    def rdmsr(self, reg):
        try:
            return struct.unpack("<Q", os.pread(self.msr, 8, reg))[0]
        except (OSError, TypeError):
            return None

    def snap(self):
        return {"t": time.time(), "tsc": self.rdmsr(0x10), "pc": {k: self.rdmsr(v) for k, v in PC_MSRS.items()},
                "rapl": {k: int(rd(v) or 0) for k, v in self.rapl.items()}}

    def measure(self, seconds):
        a, w, t0 = self.snap(), [], time.time()
        while time.time() - t0 < seconds:
            w.append(self.watts())
            time.sleep(0.5)
        b = self.snap()
        dt = b["t"] - a["t"]
        r = {"W": round(statistics.mean(w), 1), "lo": round(min(w), 1), "hi": round(max(w), 1)}
        for k, label in (("package-0", "pkg"), ("dram", "dram")):
            if k in self.rapl and b["rapl"][k] >= a["rapl"][k]:
                r[label] = round((b["rapl"][k] - a["rapl"][k]) / 1e6 / dt, 2)
        if a["tsc"] and b["tsc"] and b["tsc"] > a["tsc"]:
            for k in PC_MSRS:
                if a["pc"][k] is not None and b["pc"][k] is not None:
                    r[k] = round(100 * (b["pc"][k] - a["pc"][k]) / (b["tsc"] - a["tsc"]))
        return r

    @staticmethod
    def fmt(r):
        pcs = " ".join(f"{k} {r[k]:>3}%" for k in PC_MSRS if k in r)
        return f"{r['W']:5.1f} W | pkg {r.get('pkg', '?')!s:>5} W dram {r.get('dram', '?')!s:>5} W | {pcs}"

    @staticmethod
    def fmt_pc(r):
        pcs = " ".join(f"{k} {r[k]:>3}%" for k in PC_MSRS if k in r)
        return f"pkg {r.get('pkg', '?')!s:>5} W  dram {r.get('dram', '?')!s:>5} W | {pcs}"

    def pci_name(self, a):
        return sh("sh", "-c", f"lspci -D -s {a} | cut -d' ' -f2- | cut -c1-58")

    def link_flags(self):
        """{address: (l0s, l1)} for every PCI device that has ASPM controls."""
        out = {}
        for d in sorted(glob.glob("/sys/bus/pci/devices/*/link/l1_aspm")):
            a = d.split("/")[5]
            out[a] = (rd(d.replace("l1_aspm", "l0s_aspm")), rd(d))
        return out

    def lnkctl(self, a):
        for l in sh("lspci", "-vv", "-s", a).splitlines():
            if "LnkCtl:" in l:
                return l.split("LnkCtl:")[1].strip().split(";")[0]
        return "?"

    # --- reversible changes: each builder returns (apply, revert) -----------------------------------------------------------
    def b_alpm(self):
        files = glob.glob("/sys/class/scsi_host/host*/link_power_management_policy")
        old = {p: rd(p) for p in files}
        return (lambda: bool(files) and all([wr(p, "med_power_with_dipm") for p in files]), lambda: [wr(p, v) for p, v in old.items()])

    def b_usb(self):
        files = glob.glob("/sys/bus/usb/devices/*/power/control")
        old = {p: rd(p) for p in files}
        return (lambda: [wr(p, "auto") for p in files] and True, lambda: [wr(p, v) for p, v in old.items()])

    def b_pci(self, only=None):
        skip = {"0000:00:00.0", "0000:00:1f.0", "0000:01:00.0"}   # host bridge, LPC, the switched-off dGPU
        files = [p for p in glob.glob("/sys/bus/pci/devices/*/power/control")
                 if p.split("/")[5] not in skip and (only is None or p.split("/")[5] in only)]
        old = {p: rd(p) for p in files}
        return (lambda: [wr(p, "auto") for p in files] and True, lambda: [wr(p, v) for p, v in old.items()])

    def b_ssd(self):
        return self.b_pci(only={"0000:05:00.0", "0000:00:16.0"})

    def b_wifi(self):
        if not self.wifi:
            return (lambda: False, lambda: None)
        return (lambda: "Power save: on" in (sh("iw", "dev", self.wifi, "set", "power_save", "on") + sh("iw", "dev", self.wifi, "get", "power_save")),
                lambda: sh("iw", "dev", self.wifi, "set", "power_save", "off"))

    def b_camera(self):
        loaded = "facetimehd" in sh("lsmod")
        return (lambda: loaded and (sh("modprobe", "-r", "facetimehd") or True), lambda: loaded and sh("modprobe", "facetimehd"))

    # NOTE: there is deliberately no Thunderbolt test. On 2026-10-07 unloading its driver while the idle controller was allowed to
    # sleep left the Falcon Ridge controller "inaccessible" ("timeout resetting host router", probe error -22) and it vanished from
    # the PCI bus until the next reboot. The saving is below the measurement noise (<= 0.7 W), so it is not worth the risk.

    def b_nmi(self):
        nmi, wq = rd("/proc/sys/kernel/nmi_watchdog"), rd("/sys/module/workqueue/parameters/power_efficient")
        return (lambda: [wr("/proc/sys/kernel/nmi_watchdog", 0), wr("/sys/module/workqueue/parameters/power_efficient", "Y")] and True,
                lambda: [wr("/proc/sys/kernel/nmi_watchdog", nmi), wr("/sys/module/workqueue/parameters/power_efficient", wq or "N")])

    def b_aspm(self, policy="powersupersave"):
        pol = rd("/sys/module/pcie_aspm/parameters/policy")
        old = pol.split("[")[1].split("]")[0] if "[" in pol else "default"
        return (lambda: wr("/sys/module/pcie_aspm/parameters/policy", policy), lambda: wr("/sys/module/pcie_aspm/parameters/policy", old))

    def b_fan(self):
        files = sorted(glob.glob("/sys/devices/platform/applesmc.768/fan[0-9]_min"))
        old = {p: rd(p) for p in files}

        def on():
            temp = sh("sh", "-c", "sensors 2>/dev/null | awk '/Package id 0/{gsub(/[^0-9.]/,\"\",$4); print int($4)}'")
            if not files or int(temp or 99) > 60:
                self.say("    (CPU above 60 C or no fan control: fans left alone)")
                return False
            return all([wr(p, 1200) for p in files])
        return (on, lambda: [wr(p, v) for p, v in old.items()])

    def single(self, title, builder, settle=10, note=""):
        on, off = builder()
        self.say(f"\n## {title}")
        before = self.measure(10)["W"]
        if on() is False:
            self.say("    not applicable on this system, skipped")
            off()
            return None
        self.undo.append((title, off))
        time.sleep(settle)
        during = self.measure(20)["W"]
        off()
        self.undo.pop()
        time.sleep(5)
        after = self.measure(10)["W"]
        delta = during - (before + after) / 2
        self.say(f"    before {before:.1f} W | with change {during:.1f} W | after revert {after:.1f} W  =>  change {delta:+.2f} W {note}")
        return delta


