def mode_quiet(lab):
    lab.say(f"waiting 25 s for the terminal to go quiet; brightness {lab.orig_brightness} will be restored")
    time.sleep(25)
    a = lab.measure(35)
    lab.say(f"\n## A. normal brightness, terminal quiet\n    {lab.fmt(a)}")
    lab.set_backlight(0)
    time.sleep(6)
    b = lab.measure(25)
    lab.say(f"\n## B. backlight at 0\n    {lab.fmt(b)}")
    lab.restore_all()
    lab.say(f"\nRESULT  normal {a['W']} W | backlight off {b['W']} W | the backlight is about {round(a['W'] - b['W'], 1)} W of it")


def mode_breakdown(lab):
    lab.set_backlight(0)
    lab.say("backlight 0; starting in 12 s")
    time.sleep(12)
    p1 = lab.measure(30)
    lab.say(f"\n## 1. display on (backlight 0)\n    {lab.fmt(p1)}")
    lab.dpms("disable")
    time.sleep(1)
    p2 = None
    if lab.dpms_state() == "0":
        time.sleep(6)
        p2 = lab.measure(30)
        lab.say(f"\n## 2. display pipeline off\n    {lab.fmt(p2)}")
    else:
        lab.say("\n   (the display did not switch off; skipping phase 2)")
    lab.dpms("enable")
    time.sleep(7)
    p3 = lab.measure(20)
    lab.say(f"\n## 3. display on again (drift check)\n    {lab.fmt(p3)}")
    lab.say("\n==== SUMMARY ====")
    if p2:
        lab.say(f"  display pipeline + panel electronics (everything but the backlight): about {round(p1['W'] - p2['W'], 1)} W")
    lab.say(f"  with the display on: CPU package {p1.get('pkg', '?')} W + memory {p1.get('dram', '?')} W of {p1['W']} W total")
    lab.say(f"  deep package sleep (PC6+PC7): {(p1.get('PC6') or 0) + (p1.get('PC7') or 0)}% display on"
            + (f", {(p2.get('PC6') or 0) + (p2.get('PC7') or 0)}% display off" if p2 else ""))


def mode_singles(lab):
    lab.set_backlight(0)
    lab.say(f"backlight 0 (was {lab.orig_brightness}); starting in 12 s")
    time.sleep(12)
    base = lab.measure(25)["W"]
    lab.say(f"\nBASELINE (backlight off): {base} W")
    tests = [("FaceTime camera driver unloaded", lab.b_camera, 10, ""), ("SATA link power saving", lab.b_alpm, 10, ""), ("Runtime sleep for the SSD controller and the Intel ME", lab.b_ssd, 10, ""),
             ("NMI watchdog off + power-efficient workqueues", lab.b_nmi, 10, ""), ("Wi-Fi power saving on", lab.b_wifi, 10, ""),
             ("Fan floor lowered to 1200 rpm", lab.b_fan, 25, ""), ("PCIe ASPM policy powersave", lambda: lab.b_aspm("powersave"), 12, "")]
    res = []
    for title, builder, settle, note in tests:
        d = lab.single(title, builder, settle, note)
        if d is not None:
            res.append((d, title))
    lab.say("\n==== SUMMARY (negative = saves power; each alone; noise is about +-1 W) ====")
    for d, t in sorted(res):
        lab.say(f"  {d:+6.2f} W   {t}")
    lab.say(f"\nbaseline {base} W")


def mode_stack(lab):
    lab.set_backlight(0)
    lab.say(f"started {time.strftime('%H:%M:%S')}; backlight 0 (was {lab.orig_brightness}); starting in 12 s")
    time.sleep(12)
    lab.say("\n=== A. graphics driver display-power status (root debugfs) ===")
    for d in [d for d in glob.glob("/sys/kernel/debug/dri/*") if "i915" in rd(d + "/name")][:1]:
        for f in ("i915_fbc_status", "i915_edp_psr_status", "i915_drrs_status"):
            txt = rd(f"{d}/{f}")
            lab.say(f"  {f}: " + (" | ".join(l.strip() for l in txt.splitlines()[:4]) if txt else "(missing: not supported here)"))
    stages = [("SATA link power saving", lab.b_alpm), ("USB autosuspend (all devices)", lab.b_usb), ("PCI runtime sleep", lab.b_pci),
              ("Wi-Fi power saving", lab.b_wifi), ("FaceTime camera driver unloaded", lab.b_camera), ("PCIe ASPM powersupersave", lab.b_aspm),
              ("NMI watchdog off, power-efficient workqueues", lab.b_nmi)]
    lab.say("\n=== B. cumulative fixes, display ON (each line = this fix added to all those above) ===")
    base = lab.measure(20)
    lab.say(f"  {'0. baseline':50s} {lab.fmt(base)}")
    applied = []
    for i, (title, make) in enumerate(stages, 1):
        on, off = make()
        on()
        lab.undo.append((title, off))
        applied.append((title, on, off))
        time.sleep(8)
        r = lab.measure(20)
        lab.say(f"  {str(i) + '. + ' + title:50s} {lab.fmt(r)}")
    full = r
    lab.say("\n=== C. display OFF with ALL fixes, then each fix removed on its own ===")
    lab.dpms("disable")
    time.sleep(1)
    if lab.dpms_state() == "0":
        time.sleep(8)
        lab.say(f"  {'all fixes, display off':50s} {lab.fmt(lab.measure(20))}")
        for title, on, off in applied:
            off()
            time.sleep(6)
            lab.say(f"  {'without: ' + title:50s} {lab.fmt(lab.measure(14))}")
            on()
            time.sleep(4)
        for title, on, off in reversed(applied):
            off()
        lab.undo.clear()
        time.sleep(8)
        lab.say(f"  {'NO fixes, display off (reference)':50s} {lab.fmt(lab.measure(20))}")
        lab.dpms("enable")
    else:
        lab.say("  (the display did not switch off; skipping part C)")
    lab.say("\n=== SUMMARY ===")
    lab.say(f"  display on: baseline {base['W']} W -> all fixes {full['W']} W   (deep sleep PC6+PC7: {(base.get('PC6') or 0) + (base.get('PC7') or 0)}% -> {(full.get('PC6') or 0) + (full.get('PC7') or 0)}%)")


def mode_hunt(lab):
    """Which PCIe link keeps the CPU package at PC2/PC3? Measured with the display off (the display alone caps it at PC2).

    Safe version: it only flips the per-link L1 flag (reverted afterwards). An earlier version also took devices off the bus
    and rescanned. On 2026-10-07 that PCI rescan crashed the kernel (an oops in intel_rapl_msr, reached from rescan_store ->
    pci_bus_add_devices), killed the script before it could restore the display, and the machine hung on the next suspend.
    Never remove devices or rescan the PCI bus on this machine."""
    lab.set_backlight(0)
    lab.say("backlight 0. Charger is fine for this mode (it reads the CPU's own sleep-state counters). Starting in 12 s; hands off.")
    time.sleep(12)
    lab.dpms("disable")
    time.sleep(1)
    if lab.dpms_state() != "0":
        lab.say("the display did not switch off; aborting (package sleep cannot be read cleanly with it on)")
        return
    time.sleep(8)
    flags = lab.link_flags()
    lab.say("\n=== A. PCIe devices whose link power saving is not fully on (l0s / l1: 1 = on, 0 = off) ===")
    for a, (l0, l1) in flags.items():
        if l1 != "1" or l0 != "1":
            lab.say(f"  {a}  l0s={l0} l1={l1}  {lab.pci_name(a)}   LnkCtl: {lab.lnkctl(a)}")
    steps = []

    def record(title, r):
        steps.append((title, r))
        lab.say(f"  {title:62s} {lab.fmt_pc(r)}")

    lab.say("\n=== B. cumulative: each line = this change added to all the ones above ===")
    record("0. baseline, display off", lab.measure(20))

    def force_l1(addrs, title):
        done, refused = [], []
        for a in addrs:
            f = f"/sys/bus/pci/devices/{a}/link/l1_aspm"
            old = rd(f)
            if old != "0":
                continue
            wr(f, "1")
            if rd(f) == "1":
                done.append((f, old))
            else:
                refused.append(a)
        if done:
            lab.undo.append((title, lambda d=done: [wr(f, v) for f, v in d]))
        lab.say(f"      L1 took effect on: {', '.join(f.split('/')[5] for f, _ in done) or 'none'}"
                + (f"   REFUSED by the kernel on: {', '.join(refused)}" if refused else "")
                + "".join(f"\n        {a}: {lab.lnkctl(a)}" for a in addrs))
        time.sleep(6)
        return bool(done)

    cam = [a for a in lab.camera if flags.get(a, ("", ""))[1] == "0"]
    if cam:
        force_l1(cam, "camera link L1")
        record("1. L1 forced on the FaceTime camera link", lab.measure(20))
    tb = [a for a in lab.thunderbolt if flags.get(a, ("", ""))[1] == "0"]
    old_ctl = {a: rd(f"/sys/bus/pci/devices/{a}/power/control") for a in tb}
    if tb:                                         # keep Thunderbolt awake and reachable: only the link flag changes, no unloading
        for a in tb:
            wr(f"/sys/bus/pci/devices/{a}/power/control", "on")
        lab.undo.append(("thunderbolt power control", lambda: [wr(f"/sys/bus/pci/devices/{a}/power/control", v) for a, v in old_ctl.items() if v]))
        force_l1(tb, "Thunderbolt link L1")
        record("2. + L1 forced on the Thunderbolt links (06:00.0, 08:00.0)", lab.measure(20))
    other = [a for a, (l0, l1) in flags.items() if l1 == "0" and a not in cam + tb]
    if other:
        force_l1(other, "other links L1")
        record(f"3. + L1 forced on the remaining links ({', '.join(other)})", lab.measure(20))

    unlocked = next((t for t, r in steps if (r.get("PC6") or 0) + (r.get("PC7") or 0) >= 5), None)
    lab.say("\n=== VERDICT ===")
    if unlocked:
        lab.say(f"  deep package sleep (PC6/PC7) first appeared at: {unlocked}")
    else:
        lab.say("  deep package sleep never appeared with any link flag changed. Links whose L1 the kernel refused to enable are still untested;")
        lab.say("  the rest of the suspects (SSD, USB controller, graphics, the Thunderbolt chain, the CPU/PCH links) cannot be removed safely.")


RUN = {"quiet": mode_quiet, "breakdown": mode_breakdown, "singles": mode_singles, "stack": mode_stack, "hunt": mode_hunt}
NEEDS = {"quiet": (), "singles": (), "breakdown": ("dpms", "rapl"), "stack": ("dpms", "rapl"), "hunt": ("dpms", "rapl")}
BATTERY_ONLY = {"quiet", "breakdown", "singles", "stack"}   # these read the battery draw; hunt reads only the CPU's own counters


def show_check(lab, mode):
    print(f"power-lab {mode} --check (looks only, changes nothing)")
    rows = [("battery", lab.bat or "NOT FOUND"), ("charger plugged in", ("no (good)" if lab.on_battery() else "YES: unplug it first") if mode in BATTERY_ONLY else "either way is fine for this mode"),
            ("backlight device", f"{lab.backlight or 'NOT FOUND'} (now {lab.orig_brightness})"), ("Wi-Fi interface", lab.wifi or "none"),
            ("camera PCI", ", ".join(lab.camera) or "none"), ("Thunderbolt PCI", ", ".join(lab.thunderbolt) or "none"),
            ("Hyprland signature", "yes" if lab.sig else "MISSING (needed to switch the display off)"),
            ("RAPL (CPU package watts)", ", ".join(lab.rapl) if lab.rapl else "not available"), ("root needed", f"yes; you are {'root' if os.geteuid() == 0 else 'a normal user (it will ask for sudo)'}"),
            ("duration", MODES[mode])]
    for k, v in rows:
        print(f"  {k:26s} {v}")


def relaunch(mode, args, user):
    out = args.out or DEFAULT_OUT
    os.makedirs(out, exist_ok=True)
    print(f"power-lab {mode}: {MODES[mode]}. The screen will go dark. Hands off the keyboard and trackpad until it comes back.")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    me = Lab(user, sig, out)
    # ExecStopPost runs when the service ends however it ends (finished, killed, crashed): the display always comes back
    rescue = " ".join(["/usr/bin/python3", "-I", shlex.quote(os.path.abspath(__file__)), "rescue", f"--user={shlex.quote(user)}", f"--sig={shlex.quote(sig)}",
                       f"--brightness={me.orig_brightness or 0}"])
    cmd = ["sudo", "systemd-run", "--collect", f"--unit=power-lab-{mode}", f"--property=ExecStopPost={rescue}", "python3", "-I", os.path.abspath(__file__), mode,
           "--user", user, "--sig", sig, "--out", out]
    rc = subprocess.call(cmd)
    if rc == 0:
        print(f"started in the background. When the screen is back: power-lab results {mode}")
    return rc


def main():
    ap = argparse.ArgumentParser(prog="power-lab", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("mode", nargs="?", choices=[*MODES, "results", "rescue"])
    ap.add_argument("what", nargs="?", help="results: which mode (default: all)")
    ap.add_argument("--check", action="store_true", help="look only, change nothing")
    ap.add_argument("--user"), ap.add_argument("--sig"), ap.add_argument("--out"), ap.add_argument("--brightness")
    args = ap.parse_args()
    out = args.out or DEFAULT_OUT
    if not args.mode:
        ap.print_help()
        return 0
    if args.mode == "results":
        names = [args.what] if args.what else sorted(MODES)
        shown = 0
        for n in names:
            txt = rd(os.path.join(out, n + ".txt"))
            if txt:
                print(f"===== {n} =====\n{txt}\n")
                shown += 1
        if not shown:
            print("no results yet: run one of: " + ", ".join(MODES))
        return 0
    user = args.user or os.environ.get("SUDO_USER") or os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
    sig = args.sig if args.sig is not None else os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if args.mode == "rescue":                     # run by systemd after a test ends for ANY reason (even a crash): display and backlight back on
        if os.geteuid() != 0:
            print("rescue needs root (it is run by the test service itself)")
            return 2
        lab = Lab(user, sig, out)
        if sig:
            lab.dpms("enable")
        if lab.backlight and (args.brightness or "").isdigit() and int(args.brightness) > 0:
            lab.set_backlight(args.brightness)
        return 0
    lab = Lab(user, sig, out)
    lab.name = args.mode
    if args.check:
        show_check(lab, args.mode)
        return 0
    if os.geteuid() != 0:
        if args.mode in BATTERY_ONLY and not lab.on_battery():
            print("The charger is plugged in. Unplug it first: the draw is read from the battery.")
            return 2
        return relaunch(args.mode, args, user)
    # ---- running as root, as a background service ----
    if args.mode in BATTERY_ONLY and not lab.on_battery():
        print("charger plugged in; not running")
        return 2
    if "dpms" in NEEDS[args.mode] and not sig:
        print("no Hyprland signature; cannot switch the display off")
        return 2
    lab.open_msr()
    atexit.register(lab.restore_all)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda *a: (lab.restore_all(), sys.exit(1)))
    try:
        RUN[args.mode](lab)
    finally:
        lab.restore_all()
        lab.say(f"\nfinished {time.strftime('%H:%M:%S')}; all changes reverted; display and brightness restored")
        for f in glob.glob(os.path.join(out, "*")):
            try:
                os.chown(f, pwd.getpwnam(user).pw_uid, -1)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
