_MOD_WORD = {"M": "Super", "C": "Ctrl", "A": "Alt", "S": "Shift", "G": "AltGr"}


def section(header, rows):
    out = [f"[{header}]", ""]
    for key, action, why in rows:
        out.append(f"# {why}")
        out.append(f"{key} = {action}")
    out.append("")
    return out


FULL_ID = re.compile(r"[0-9a-f]{4}:[0-9a-f]{4}:[0-9a-f]{8}")


def conf(ids, caps_delay=CAPS_DELAY_DEFAULT):
    if not ids:
        raise ValueError("at least one keyboard id is needed (keyd-config detect)")
    for i in ids:
        if not FULL_ID.fullmatch(i):
            raise ValueError(f"not a full keyd id of the form vvvv:pppp:hhhhhhhh (a shorter or k: id also matches the trackpad): {i!r}")
    if not (0 <= caps_delay <= 1000):
        raise ValueError("caps delay must be 0 to 1000 ms")
    out = [
        "# Omarchy Kit: the Mac command layer for keyd. Written by keys/keyd-config; do not edit, re-run keys/install-keyd.",
        "#",
        "# IF THE KEYBOARD EVER MISBEHAVES: press Backspace + Escape + Enter together. keyd quits at once and the",
        "# keyboard is back to normal. Undo for good: sudo keys/install-keyd --remove",
        "#",
        "# Only the keyboards below are changed, each by its FULL id (vendor:product:hash). The Apple keyboard and the trackpad share",
        "# vendor and product, so a shorter id (or keyd's keyboard-only k: prefix) also grabbed the trackpad. The hash is keyd's own.",
        "# A keyboard plugged in later keeps its normal keys. Both Command keys are the same layer: neither is Super any more.",
        "",
        "[ids]",
        "",
        *ids,
        "",
        "[main]",
        "",
        "# Both Command keys become the layer below; it acts as Ctrl for every key that layer does not list.",
        "leftmeta = layer(cmd)",
        "rightmeta = layer(cmd)",
    ]
    if caps_delay:
        out += [
            f"# Caps Lock needs a deliberate press of {caps_delay} ms, as on a Mac (a quick brush does nothing).",
            f"capslock = timeout(noop, {caps_delay}, capslock)",
        ]
    out.append("")
    out += section("cmd:C", CMD_KEYS)
    out += ["# Active while Command is held after the first Tab: Super stays down until Command is released.", ""]
    out += section("cmd_switch:M", SWITCH_KEYS)
    out += ["# Physical Control, as on a Mac: Mission Control and Spaces. (Control with Command or Option is a composite layer below.)", ""]
    out += section("control", CONTROL_KEYS)
    out += ["# Composite layers (two modifiers at once) must come after the layers they combine.", ""]
    out += section("cmd+shift", SHIFT_CMD_KEYS)
    out += section("cmd+alt", ALT_CMD_KEYS)
    out += section("control+cmd", CTRL_CMD_KEYS)
    out += section("control+shift", CONTROL_SHIFT_KEYS)
    out += section("control+alt", CONTROL_ALT_KEYS)
    out += ["# Option (left and right): word movement as on a Mac. Terminals get Alt+Backspace back from keyd-appmap.", ""]
    out += section("alt", OPTION_KEYS)
    out += section("altgr", OPTION_KEYS)
    return "\n".join(out).rstrip() + "\n"


def overlays_json():
    return json.dumps({"version": 1, "overlays": OVERLAYS}, indent=2, ensure_ascii=False) + "\n"


def config_super_chords():
    """Every Super (M) chord the static configuration sends, as 'Super+Alt+space'-style words (for the consistency test)."""
    found = set()
    for rows in (CMD_KEYS, SWITCH_KEYS, SHIFT_CMD_KEYS, ALT_CMD_KEYS, CTRL_CMD_KEYS, CONTROL_KEYS, CONTROL_ALT_KEYS):
        for _, action, _ in rows:
            m = re.search(r"(?:^|\()((?:[MCASG]-)+)([^\s,)]+)\)?$", action)
            if m and "M" in m.group(1).replace("-", ""):
                found.add((tuple(sorted(_MOD_WORD[c] for c in m.group(1) if c in _MOD_WORD)), m.group(2)))
    return found


def chords_text():
    w0 = max(len(r[0]) for r in SUPER_CHORDS)
    w1 = max(len(r[1]) for r in SUPER_CHORDS)
    lines = [f"{'pressed':<{w0}}  {'Hyprland receives':<{w1}}  today in Omarchy / who binds it"]
    for pressed, sends, today, who in SUPER_CHORDS:
        lines.append(f"{pressed:<{w0}}  {sends:<{w1}}  {today} / {who}")
    return "\n".join(lines) + "\n"


def _bitmap(blk, name):
    """The capability bitmap `B: NAME=...` of a /proc/bus/input/devices block as an integer (0 if the device has none)."""
    m = re.search(rf"^B: {name}=(.*)$", blk, re.M)
    value = 0
    for word in (m.group(1).split() if m else []):
        value = (value << 64) | int(word, 16)   # the kernel prints the most significant unsigned long first
    return value


def keyd_hash(num_keys, absmask, relmask, name):
    """keyd's device hash (device.c, generate_uid): djb2 over the key count, the first byte of the ABS and REL masks and the name.
    Checked against the ids keyd itself logged for this MacBook's keyboard, its trackpad and five other devices."""
    h = 5183
    for byte in ((num_keys >> 24) & 255, (num_keys >> 16) & 255, (num_keys >> 8) & 255, num_keys & 255, absmask, relmask):
        h = (h * 33 + byte) & 0xFFFFFFFF
    for ch in name.encode("utf-8"):
        h = (h * 33 + (ch if ch < 128 else ch - 256)) & 0xFFFFFFFF   # keyd adds a C `char`, which is signed
    return h


def device_ids(text):
    """(keyd id, name, handlers) of every input device in the text of /proc/bus/input/devices that has capability bitmaps."""
    found = []
    for block in re.split(r"\n\s*\n", text):
        m = re.search(r"Vendor=([0-9a-fA-F]{4}) Product=([0-9a-fA-F]{4})", block)
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        handlers = re.search(r"^H: Handlers=(.*)", block, re.M)
        if not (m and name and handlers and re.search(r"^B: KEY=", block, re.M)):
            continue
        h = keyd_hash(bin(_bitmap(block, "KEY")).count("1"), _bitmap(block, "ABS") & 255, _bitmap(block, "REL") & 255, name.group(1))
        found.append((f"{m.group(1).lower()}:{m.group(2).lower()}:{h:08x}", name.group(1), handlers.group(1).split(), block))
    return found


def detect(text):
    """Full keyd ids (vvvv:pppp:hhhhhhhh) of the Apple keyboards in the text of /proc/bus/input/devices: Apple's vendor, a keyboard
    handler, "keyboard" in the name, and no pointer axes (the trackpad shares the keyboard's vendor and product and has them)."""
    ids = []
    for kid, name, handlers, block in device_ids(text):
        if (kid.split(":")[0] in APPLE_VENDORS and "kbd" in handlers and "keyboard" in name.lower()
                and not (_bitmap(block, "ABS") or _bitmap(block, "REL"))):
            if kid not in ids:
                ids.append(kid)
    return ids


def usage(code):
    print(__doc__.split("What the layer does")[0].strip(), file=sys.stderr if code else sys.stdout)
    sys.exit(code)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        usage(0 if argv else 2)
    cmd, rest = argv[0], argv[1:]
    if cmd == "conf":
        ids, delay, i = [], CAPS_DELAY_DEFAULT, 0
        while i < len(rest):
            if rest[i] == "--ids" and i + 1 < len(rest):
                ids += [x for x in rest[i + 1].split(",") if x]
                i += 2
            elif rest[i] == "--caps-delay" and i + 1 < len(rest) and rest[i + 1].isdigit():
                delay = int(rest[i + 1])
                i += 2
            else:
                usage(2)
        try:
            sys.stdout.write(conf(ids, delay))
        except ValueError as e:
            print(f"keyd-config: {e}", file=sys.stderr)
            sys.exit(1)
    elif cmd == "overlays" and not rest:
        sys.stdout.write(overlays_json())
    elif cmd == "chords" and not rest:
        sys.stdout.write(chords_text())
    elif cmd == "detect" and len(rest) <= 1:
        try:
            text = open(rest[0] if rest else "/proc/bus/input/devices", encoding="utf-8", errors="replace").read()
        except OSError as e:
            print(f"keyd-config: {e}", file=sys.stderr)
            sys.exit(1)
        ids = detect(text)
        print("\n".join(ids))
        sys.exit(0 if ids else 1)
    else:
        usage(2)


if __name__ == "__main__":
    main(sys.argv[1:])
