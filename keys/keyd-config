    ("delete", "C-delete", "delete the word after the cursor"),
]
# Physical Control, as on a Mac: Mission Control and Spaces. They go to Hyprland as the Super chords macdock.lua and Omarchy bind.
CONTROL_KEYS = (
    [("up", "M-C-up", "⌃↑: Mission Control"),
     ("down", "M-C-down", "⌃↓: App Exposé (the focused app's windows)"),
     ("left", "M-C-S-left", "⌃←: previous Space (workspace)"),
