    ("⌥⌘W", "Super+W", "Close window (exists)", "Omarchy"),
    ("⇧⌘Q", "Super+Escape", "System menu (exists)", "Omarchy"),
    ("⌃↑", "Super+Ctrl+Up", "Mission Control", "dock/macdock.lua"),
    ("⌃↓", "Super+Ctrl+Down", "App Exposé", "dock/macdock.lua"),
    ("⌃←", "Super+Ctrl+Shift+Left", "previous workspace", "dock/macdock.lua"),
    ("⌃→", "Super+Ctrl+Shift+Right", "next workspace", "dock/macdock.lua"),
    ("⌃1 … ⌃0", "Super+1 … Super+0", "switch to workspace 1 … 10 (exists)", "Omarchy"),
    ("⌃⌥←↑→↓", "Super+←↑→↓", "focus the window in that direction (exists)", "Omarchy"),
    ("⌘W in a terminal", "Super+W", "Close window (exists)", "Omarchy"),
    ("⌘N in a terminal", "Super+Return", "Terminal (exists)", "Omarchy"),
