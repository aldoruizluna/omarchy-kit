#!/usr/bin/env python3
"""keyd-config: write the Mac ⌘ layer for keyd, and the per-app overlays that go with it. Standard library only; reads nothing
on the system except what `detect` is told to read, and changes nothing: it only prints.

  keyd-config conf [--ids ID[,ID...]] [--caps-delay MS]   the keyd configuration (default ids: none, so give some)
  keyd-config overlays                                     the overlays for keyd-appmap, as JSON
  keyd-config chords                                       the Super chords the layer sends (the Hyprland side must bind these)
  keyd-config detect [FILE]                                Apple keyboards in /proc/bus/input/devices, as full keyd ids (vvvv:pppp:hhhhhhhh), one per line

What the layer does (the installer is keys/install-keyd, the explanation is in keys/README.md):
  * Both ⌘ keys act as Ctrl for every key they do not list, so every shortcut, ⌘-click and ⌘-scroll work in every app, and the two
    keys are identical, as a Mac's are. No key is Super any more: Omarchy's own Super shortcuts are reached through the Mac chords below.
  * A few ⌘ chords are Mac *system* chords; they are turned into Super chords that Hyprland binds (see `chords`). So are the Mac's
    Control chords for Spaces and Mission Control (⌃←/→, ⌃1…0, ⌃↑/↓) and ⌃⌥ with the arrows (focus the window in that direction).
  * Only the keyboard's own full id (vvvv:pppp:hhhhhhhh) is listed: the Apple keyboard and the trackpad share vendor and product, and keyd's
    keyboard-only prefix did not keep the trackpad out. The hash is keyd's own (djb2 over the capability counts and the name), recomputed here.
  * ⌘←/→ Home/End, ⌘↑/↓ top/bottom, ⌥←/→ word jumps, ⌥⌫ delete word, ⌘[ and ⌘] back/forward, ⇧⌘[ and ⇧⌘] tabs.
  * Copy and paste are written terminal-safe (Ctrl+Insert, Shift+Insert: a terminal reads Ctrl+C as "interrupt");
    keyd-appmap switches them to plain Ctrl+C / Ctrl+V while an app (not a terminal) has the focus.
  * Caps Lock needs a short deliberate press, like on a Mac (default 150 ms; 0 turns this off).
"""
import json
import re
import sys

CAPS_DELAY_DEFAULT = 150
APPLE_VENDORS = ("05ac", "004c")  # Apple's USB and Bluetooth vendor ids

# The terminal chords that must never reach a shell as Ctrl+letter. ⌘ is Ctrl, and in a terminal Ctrl+D ends the shell,
# Ctrl+Z stops the program, Ctrl+S freezes the output. Physical Ctrl still sends all of these, the way a Mac's Control does.
TERMINAL_NOOP = "a b d e f g i j o p r s t u x y z".split()

# Layer sections of the static configuration: (header, [(key, action, why)]).
# Comments go on their own lines because keyd does not accept a trailing comment after a binding.
