# ⌃⇧ with the arrows is text selection by word for anyone who still reaches for Ctrl, so it must not fall through to ⌃←/→.
CONTROL_SHIFT_KEYS = [(d, f"C-S-{d}", f"⌃⇧{d}: unchanged") for d in ("left", "right", "up", "down")]
# ⌃⌥ with the arrows: focus the window in that direction (the tiling Omarchy has, with the modifiers a Mac window tiler uses).
CONTROL_ALT_KEYS = [(d, f"M-{d}", f"⌃⌥{d}: focus the window in that direction (Super+{d})") for d in ("left", "right", "up", "down")]

# Overlays applied at run time with `keyd bind` by keyd-appmap, chosen by what has the focus.
OVERLAYS = {
    # an app: ⌘C and ⌘V are plain Ctrl+C and Ctrl+V (file managers do not take Ctrl+Insert)
    "app": ["cmd.c = C-c", "cmd.v = C-v"],
    # a terminal: nothing a Mac user presses with ⌘ may reach the shell as Ctrl+letter
    "terminal": (
        ["cmd.c = C-insert", "cmd.v = S-insert",
         "cmd.k = C-l",        # ⌘K: clear the screen
         "cmd.w = M-w",        # ⌘W: close the window (Super+W)
         "cmd.n = M-enter",    # ⌘N: new terminal (Super+Return)
         "cmd.dot = C-c",      # ⌘. cancels, as in Terminal and iTerm
         "cmd+shift.c = C-S-c",   # ⇧⌘C and ⇧⌘V: the Ctrl+Shift forms every Omarchy terminal takes
         "cmd+shift.v = C-S-v",
         "cmd.backspace = C-u",   # ⌘⌫: a shell deletes to the start of the line on Ctrl+U
         "alt.backspace = A-backspace",   # a shell deletes a word on Alt+Backspace; Ctrl+Backspace is one character
         "altgr.backspace = A-backspace"]
        + [f"cmd.{k} = noop" for k in TERMINAL_NOOP]
    ),
}
# keyd-appmap treats "no window" (a launcher or menu has the focus) and "no answer from the compositor" as an app.

# Super chords the layer sends: (what is pressed, what Hyprland receives, what it means today in Omarchy, who binds it).
# keyd-config's `chords` prints this; test_keyd.py checks that every Super chord in the configuration is listed.
SUPER_CHORDS = [
    ("⌘Space", "Super+Alt+Space", "Spotlight (replaces Omarchy's Apps menu on this chord)", "dock/macdock.lua"),
