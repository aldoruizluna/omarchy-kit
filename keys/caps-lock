#!/bin/bash
# caps-lock: should Caps Lock be a real Caps Lock, like on a Mac, or Omarchy's Compose key? No root.
#   caps-lock real      a normal Caps Lock (the light on the key follows it); Shift does not cancel it; both Shifts do nothing special
#   caps-lock compose   Omarchy's default: Caps Lock is the Compose key (press, release, then ' and e gives é); both Shifts toggle Caps Lock
#   caps-lock           show the current choice
# Edits a marked block at the end of ~/.config/hypr/input.lua (a backup of the file as it was is kept once as input.lua.bak-caps), reloads
# Hyprland, restarts fcitx5 (it copies the keymap when it starts) and rebuilds the kit pages. Right Option still types accents either way.
# With keys/install-keyd, Caps Lock also needs a deliberate press (150 ms) like on a Mac; that part is keyd's, not this script's.
set -euo pipefail
LUA=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/input.lua
KIT=$(cd "$(dirname "$0")/.." && pwd)
BEGIN='-- >>> caps-lock (omarchy-kit/keys/caps-lock)'
END='-- <<< caps-lock'
current() { if grep -qF -- "$BEGIN" "$LUA" 2>/dev/null; then echo real; else echo compose; fi; }
live() { hyprctl -j getoption input:kb_options 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("str",""))' 2>/dev/null || true; }

(($# <= 1)) || { echo "usage: $(basename "$0") [real|compose]   (--help for details)" >&2; exit 2; }
case ${1:-} in
  "") echo "caps lock: $(current)"; exit 0 ;;
  real | compose) ;;
  -h | --help) sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;;
  *) echo "usage: $(basename "$0") [real|compose]   (--help for details)" >&2; exit 2 ;;
esac
[[ -f $LUA ]] || { echo "no $LUA" >&2; exit 1; }
[[ -f $LUA.bak-caps ]] || cp -p "$LUA" "$LUA.bak-caps"

# the file without an earlier block of ours
TMP=$(mktemp "$LUA.XXXXXX")
trap 'rm -f "$TMP"' EXIT
# (the blank line that separates the block from the text above goes with it, so real then compose gives the file back byte for byte)
awk -v b="$BEGIN" -v e="$END" '
  { line[NR] = $0 }
  END {
    for (i = 1; i <= NR; i++) {
      if (index(line[i], b)) { skip = 1; if (n > 0 && out[n] == "") n-- }
      if (!skip) out[++n] = line[i]
      if (index(line[i], e)) skip = 0
    }
    for (i = 1; i <= n; i++) print out[i]
  }' "$LUA" >"$TMP"

if [[ $1 == real ]]; then
  # keep whatever else Omarchy puts in kb_options (for example the Alt+Alt layout switch of a non-Latin install), drop only the two Caps Lock options
  rest=$(tr ',' '\n' <<<"$(live)" | grep -vxE 'compose:caps|shift:both_capslock_cancel|\[\[EMPTY\]\]|' | paste -sd, - || true)
  {
    echo
    echo "$BEGIN"
    echo "-- Caps Lock is a real Caps Lock, like on a Mac: it capitalises, the light on the key follows it, Shift does not cancel it."
    echo "-- Omarchy's default makes Caps Lock the Compose key (press, release, then ' and e gives é; right Option does the same job)"
    echo "-- and puts Caps Lock on both Shifts. kb_options keeps what else Omarchy had in it when this was written."
    echo "-- Undo: ~/labspace/omarchy-kit/keys/caps-lock compose   (or delete this block, then hyprctl reload and restart fcitx5)"
    echo "hl.config({ input = { kb_options = \"$rest\" } })"
    echo "$END"
  } >>"$TMP"
fi
chmod --reference="$LUA" "$TMP"
mv "$TMP" "$LUA"

hyprctl reload >/dev/null
sleep "${CAPS_LOCK_SETTLE:-1}"
errs=$(hyprctl configerrors)
[[ -z $errs ]] || { echo "Hyprland reported errors:"; echo "$errs"; exit 1; }
if systemctl --user is-active --quiet omarchy-fcitx5.service 2>/dev/null; then systemctl --user restart omarchy-fcitx5.service || true; fi
python3 "$KIT/build_cheatsheet.py" >/dev/null 2>&1 || true
echo "caps lock: $(current)   (kb_options now: '$(live)')"
