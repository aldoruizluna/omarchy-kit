#!/usr/bin/env python3
"""Omarchy Kit local server (127.0.0.1:8787, runs as omarchy-kit.service).

Serves the portal pages, and exposes three things to them:
  GET  /api/state  read-only snapshot of the desktop (workspace, windows, theme, volume) so lessons can
                   check that you really did the exercise
  POST /api/menu   open the real Omarchy menu at a route — only routes that exist in the menu definition
  POST /install    run install-apps for ids listed in apps.toml, in a terminal so sudo can prompt
  POST /api/theme  switch the Omarchy theme (only names from the installed theme list)
  GET  /theme.css, /api/theme, /api/live, /api/top, /wallpaper  the current theme and live hardware history
All POSTs need the per-run token embedded in the pages it serves; the Host check blocks DNS rebinding.
"""
import hmac, json, secrets, subprocess, sys, threading, webbrowser
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from appslib import load, render, HERE
from install_status import installed
import kitlive

PORT = 8787
TOKEN = secrets.token_urlsafe(24)
HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}

PAGES = {"/": "index.html", "/index.html": "index.html", "/learn": "learn.html", "/mac": "mac.html",
         "/macbook": "macbook.html", "/reference": "reference.html", "/cheatsheet": "cheatsheet.html",
         "/keyboard": "keyboard.html", "/trackpad": "trackpad.html", "/system": "system.html", "/games": "games.html"}
ASSETS = {"/portal.css": "text/css; charset=utf-8", "/portal.js": "text/javascript; charset=utf-8", "/portal-nav.js": "text/javascript; charset=utf-8",
          "/kit.css": "text/css; charset=utf-8", "/kit.js": "text/javascript; charset=utf-8", "/data/kit-index.json": "application/json"}


def run_json(*cmd):
    try:
        return json.loads(subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout or "null")
    except Exception:
        return None


def run_text(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout.strip()
    except Exception:
        return ""


def desktop_state():
    aw = run_json("hyprctl", "-j", "activewindow") or {}
    mons = run_json("hyprctl", "-j", "monitors") or []
    clients = run_json("hyprctl", "-j", "clients") or []
    mon = next((m for m in mons if m.get("focused")), mons[0] if mons else {})
    vol = run_text("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
    return {
        "ws": (mon.get("activeWorkspace") or {}).get("id"),
        "special": (mon.get("specialWorkspace") or {}).get("name") or "",
        "active": {"class": aw.get("class"), "floating": aw.get("floating"), "fullscreen": aw.get("fullscreen"),
                   "ws": (aw.get("workspace") or {}).get("id"), "addr": aw.get("address"), "grouped": len(aw.get("grouped") or [])},
        "clients": [{"addr": c.get("address"), "class": c.get("class"), "ws": (c.get("workspace") or {}).get("id")} for c in clients],
        "theme": run_text("omarchy-theme-current"),
        "volume": vol.replace("Volume: ", ""),
        "shot": newest_shot(),
    }


def newest_shot():
    """mtime of the newest image in Omarchy's screenshot folder (~/Pictures), for the screenshot lesson."""
    import glob, os
    files = glob.glob(os.path.expanduser("~/Pictures/*.png"))
    return max((os.path.getmtime(f) for f in files), default=0)


def read(path):
    try:
        with open(path) as f: return f.read().strip()
    except Exception:
        return ""


def hardware():
    """Live MacBook readings for the Your-MacBook page (all read-only sysfs/CLI)."""
    import glob, os
    gpu = "unknown"
    for link in glob.glob("/sys/class/drm/card*-eDP-1"):
        dev = os.path.realpath(link)
        gpu = "nvidia" if "0000:01:00.0" in dev else "intel" if "0000:00:02.0" in dev else "unknown"
    temps = {}
    for hw in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(hw + "/name") == "coretemp":
            temps["cpu"] = int(read(hw + "/temp1_input") or 0) // 1000
        if read(hw + "/name") == "nouveau":
            temps["gpu"] = int(read(hw + "/temp1_input") or 0) // 1000
    fans = [int(read(f) or 0) for f in sorted(glob.glob("/sys/devices/platform/applesmc.768/fan*_input"))]
    bat = "/sys/class/power_supply/BAT0"
    full, design = int(read(bat + "/charge_full") or 0), int(read(bat + "/charge_full_design") or 0)
    return {"gpu": gpu, "temps": temps, "fans": fans,
            # charge vs. the battery's *current* full capacity (the kernel's "capacity" here is vs. design)
            "battery": {"pct": round(100 * int(read(bat + "/charge_now") or 0) / full) if full else int(read(bat + "/capacity") or 0),
                        "status": read(bat + "/status"),
                        "health": round(100 * full / design) if design else None, "cycles": read(bat + "/cycle_count")},
            "profile": run_text("powerprofilesctl", "get"),
            "powerauto": run_text("systemctl", "--user", "is-active", "power-auto.service") == "active",
            "sleep": sleep_state()}


_sleep = {"t": 0, "v": None}
def sleep_state():
    """Verdict of sleep/sleep-check (journal, no root); cached because /api/hw is polled every 5 s."""
    import time
    if time.time() - _sleep["t"] > 60:
        try:
            _sleep["v"] = json.loads(subprocess.run([str(HERE / "sleep" / "sleep-check"), "--json"], capture_output=True, text=True, timeout=20).stdout or "null")
        except Exception:
            _sleep["v"] = None
        _sleep["t"] = time.time()
    return _sleep["v"]


def menu_ids():
    try:
        return set(json.loads((HERE / "data" / "menu_ids.json").read_text()))
    except Exception:
        return set()


_busy = threading.Lock()   # one long games job (scan, ingest, export) at a time


class H(BaseHTTPRequestHandler):
    timeout = 30   # a stalled client cannot hold a handler thread forever

    def log_message(self, *a): pass

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        if ctype.startswith("text/html"):  # kit.js reads the token from here to call the POST endpoints
            body = body.replace('<meta name="kit-token" content="">', f'<meta name="kit-token" content="{TOKEN}">', 1)
        b = body.encode(); self.send_response(code)
        self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(b)

    def _host_ok(self): return self.headers.get("Host") in HOSTS

    def _page(self, name):
        if not (HERE / name).exists():
            return self._send(500, f"{name} has not been built yet: run python3 build_cheatsheet.py")
        html = (HERE / name).read_text()
        return self._send(200, html.replace("/*__TOKEN__*/null", json.dumps(TOKEN)), "text/html; charset=utf-8")

    def do_GET(self):
        if not self._host_ok(): return self._send(403, "bad host")
        p = self.path.split("?")[0]
        if p in PAGES: return self._page(PAGES[p])
        if p in ASSETS: return self._send(200, (HERE / p.lstrip("/")).read_text(), ASSETS[p])
        if p == "/favicon.ico":  # the Omarchy logo, so the tab and launcher match
            data = Path("/usr/share/omarchy/icon.png").read_bytes()
            self.send_response(200); self.send_header("Content-Type", "image/png"); self.send_header("Content-Length", str(len(data)))
            self.end_headers(); return self.wfile.write(data)
        if p == "/setup":  # status is re-checked on every visit; a visit never writes into the repo
            import build_setup
            return self._send(200, build_setup.build(write=False), "text/html; charset=utf-8")
        if p == "/apps": return self._send(200, render(TOKEN), "text/html; charset=utf-8")
        if p == "/status": return self._send(200, json.dumps({a["id"]: installed(a) for a in load()}), "application/json")
        if p == "/api/state": return self._send(200, json.dumps(desktop_state()), "application/json")
        if p == "/api/hw": return self._send(200, json.dumps(hardware()), "application/json")
        if p == "/theme.css": return self._send(200, kitlive.theme_css(), "text/css; charset=utf-8")
        if p == "/api/theme":
            return self._send(200, json.dumps({"name": kitlive.theme_name(), "version": kitlive.theme_version(),
                                               "colors": kitlive.theme_colors(), "themes": kitlive.theme_list()}), "application/json")
        if p == "/api/live":
            q = dict(x.split("=", 1) for x in self.path.partition("?")[2].split("&") if "=" in x)
            try: since = float(q.get("since", 0))
            except ValueError: since = 0
            out = {"samples": kitlive.history(since), "theme": kitlive.theme_version()}
            if q.get("snap") != "0":      # the home sparkline only needs the samples; the snapshot costs about 130 ms
                out["snap"] = kitlive.snapshot()
            return self._send(200, json.dumps(out), "application/json")
        if p == "/api/games": return self._send(200, json.dumps(kitlive.games()), "application/json")
        if p == "/api/top": return self._send(200, json.dumps(kitlive.top()), "application/json")
        if p == "/wallpaper":
            w, mime = kitlive.wallpaper_small()
            if not w: return self._send(404, "no wallpaper")
            data = Path(w).read_bytes()
            self.send_response(200); self.send_header("Content-Type", mime or ("image/png" if w.endswith(".png") else "image/webp" if w.endswith(".webp") else "image/jpeg"))
            self.send_header("Content-Length", str(len(data))); self.send_header("Cache-Control", "max-age=60"); self.end_headers()
            return self.wfile.write(data)
        return self._send(404, "not found")

    def do_POST(self):
        if not self._host_ok(): return self._send(403, "bad host")
        if not hmac.compare_digest(self.headers.get("X-Token") or "", TOKEN): return self._send(403, "forbidden")
        try: body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        except Exception: return self._send(400, "bad json")
        if self.path == "/api/menu":
            route = body.get("route", "root")
            if route != "root" and route not in menu_ids(): return self._send(400, "unknown menu route")
            subprocess.Popen(["omarchy-menu", "summon", route])
            return self._send(200, "opened")
        if self.path == "/api/games/scan":  # rebuild playlists now; box art downloads continue in the background
            tool = str(HERE / "games" / "kit-games")
            if not _busy.acquire(blocking=False): return self._send(409, json.dumps({"ok": False, "message": "another games job is still running"}), "application/json")
            try: r = subprocess.run([tool, "scan"], capture_output=True, text=True, timeout=600)
            except subprocess.TimeoutExpired: return self._send(504, json.dumps({"ok": False, "message": "the scan took longer than 10 minutes"}), "application/json")
            finally: _busy.release()
            subprocess.Popen([tool, "art"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            kitlive._games["t"] = 0
            lines = [l for l in r.stdout.splitlines() if l.strip()]
            msg = next((l for l in reversed(lines) if "WARNING" in l), lines[-1] if lines else "done")
            return self._send(200, json.dumps({"message": msg + " · box art downloading…", "ok": r.returncode == 0}), "application/json")
        if self.path in ("/api/games/ingest", "/api/games/export-telesia"):
            cmd = self.path.rsplit("/", 1)[1]
            if not _busy.acquire(blocking=False): return self._send(409, json.dumps({"ok": False, "lines": ["another games job is still running"]}), "application/json")
            try: r = subprocess.run([str(HERE / "games" / "kit-games"), cmd], capture_output=True, text=True, timeout=3600)
            except subprocess.TimeoutExpired: return self._send(504, json.dumps({"ok": False, "lines": ["took longer than an hour; stopped"]}), "application/json")
            finally: _busy.release()
            kitlive._games["t"] = 0
            lines = [l for l in r.stdout.splitlines() if l.strip()]
            return self._send(200, json.dumps({"ok": r.returncode == 0, "lines": lines[-40:]}), "application/json")
        if self.path == "/api/theme":
            ok = kitlive.set_theme(str(body.get("id", "")))
            return self._send(200 if ok else 400, "switching" if ok else "unknown theme")
        if self.path == "/install":
            ids = body.get("ids", [])
            known = {a["id"] for a in load()}
            if not ids or not all(isinstance(i, str) and i in known for i in ids): return self._send(400, "unknown app id")
            # ids reach the script as arguments, never as part of the shell text
            subprocess.Popen(["xdg-terminal-exec", "bash", "-c", '"$0" "$@"; echo; read -rp "Done. Press Enter to close. "', f"{HERE}/install-apps", *ids])
            return self._send(200, "started")
        return self._send(404, "not found")


if __name__ == "__main__":
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
    kitlive.start_sampler()
    print(f"Omarchy Kit: http://127.0.0.1:{PORT}/   (Ctrl+C to stop)")
    if "--no-open" not in sys.argv: webbrowser.open(f"http://127.0.0.1:{PORT}/")
    try: srv.serve_forever()
    except KeyboardInterrupt: pass
