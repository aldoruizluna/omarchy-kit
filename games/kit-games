#!/usr/bin/env python3
"""kit-games: keep a retro library organised, playable and inside its disk budget.

  kit-games init      create ~/Games/roms/<system> folders and fix the budget (half the free disk, once)
  kit-games scan      build one RetroArch playlist per system, each pinned to the best core for this machine
  kit-games art       download box art, screenshots and title screens for every playlist entry
  kit-games budget    show space used per system against the plan; exits 1 when over the cap
  kit-games bios      show which BIOS files each system's core needs and whether ~/Games/bios has them
  kit-games status    budget + BIOS as JSON (used by the Omarchy Kit Setup log)
  kit-games ingest    identify your own dumps in ~/Games/inbox against libretro's No-Intro/Redump databases,
                      rename them to the canonical title, compress discs (CHD) and GameCube (RVZ), file them
  kit-games cabinet   generate a RetroFE "cabinet mode" in ~/Games/retrofe over this library (collections,
                      RetroArch launchers, box art, PS4 controls) and a "Retro Cabinet" launcher entry
  kit-games esde      configure ES-DE (EmulationStation Desktop Edition) over this library: ROM folder, gamelists
                      with titles/developers/descriptions (merged, so favorites and play counts survive), the
                      cores chosen here, box art / screenshots / title screens, and an "ES-DE" launcher entry
  kit-games dolphin   configure standalone Dolphin for GameCube from this machine's benchmarks (OpenGL, 2x, hybrid
                      ubershaders, VSync), PS4 controller + keyboard on port 1, hotkeys like RetroArch's, saves in
                      ~/Games, and make ES-DE launch GameCube games with it
  kit-games export-telesia [--upload]
                      write ~/Games/telesia/library.json for Telesia's import (RetroArch playlist items with
                      clean titles + playtime from RetroArch's runtime logs); --upload sends it when
                      TELESIA_TOKEN (a Janua bearer) is set
  kit-games store <action>
                      a store of free games from a signed catalog snapshot: refresh [--from SOURCE] [--accept-drops],
                      list [--platform P] [--mode host|link|guide] [--installed], search Q, info REF, get REF...,
                      remove REF..., sync, health. Needs the publisher's public key in
                      ~/.config/omarchy-kit/store-publisher.pem; commercial games are guide entries, never files

Systems, cores and allocations live in systems.toml next to this script. Commercial ROMs are never
downloaded by this tool: put your own dumps in ~/Games/roms/<folder>, named the No-Intro/Redump way
("Title (Region).ext") so playlists and box art match. `store` only installs games a catalog marks as
free to download (homebrew, freeware), verified against the catalog's checksums.
"""
import json, os, re, shutil, subprocess, sys, tomllib, urllib.error, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLAN = tomllib.loads((HERE / "systems.toml").read_text())
SYSTEMS = PLAN["system"]
GAMES = Path.home() / "Games"
ROMS, BIOS = GAMES / "roms", GAMES / "bios"
BUDGET_FILE = GAMES / ".kit-budget.json"
MISSING_ART = GAMES / ".kit-art-missing.json"
RA = Path.home() / ".config/retroarch"
CORES, INFO = Path("/usr/lib/libretro"), Path("/usr/share/libretro/info")
GB = 1e9


def ra_setting(key, default):
    try:
        for line in (RA / "retroarch.cfg").read_text().splitlines():
            m = re.match(rf'{key}\s*=\s*"(.*)"', line)
            if m and m[1] and m[1] != "default": return Path(os.path.expanduser(m[1].replace(":", str(RA), 1) if m[1].startswith(":") else m[1]))
    except FileNotFoundError:
        pass
    return default


PLAYLISTS = ra_setting("playlist_directory", RA / "playlists")
THUMBS = ra_setting("thumbnails_directory", RA / "thumbnails")


def du(path):
    total = 0
    for root, _, files in os.walk(path):
        for f in files:
            try: total += os.lstat(os.path.join(root, f)).st_size
            except OSError: pass
    return total


def info(core):
    out = {}
    try:
        for line in (INFO / f"{core}_libretro.info").read_text().splitlines():
            m = re.match(r'\s*(\w+)\s*=\s*"?(.*?)"?\s*$', line)
            if m: out[m[1]] = m[2]
    except FileNotFoundError:
        pass
    return out


def games_in(sysdef):
    """Playable files for a system; disc images referenced by an .m3u are hidden behind the .m3u."""
    folder = ROMS / sysdef["folder"]
    if not folder.is_dir(): return []
    exts = {"." + e for e in sysdef["exts"]}
    files = sorted(p for p in folder.rglob("*") if p.is_file() and p.suffix.lower() in exts)
    hidden = set()
    for m3u in (p for p in files if p.suffix.lower() == ".m3u"):
        for line in m3u.read_text(errors="ignore").splitlines():
            if line.strip() and not line.startswith("#"): hidden.add((m3u.parent / line.strip()).resolve())
    if any(p.suffix.lower() in (".cue", ".gdi") for p in files):  # .bin tracks belong to their .cue/.gdi
        files = [p for p in files if p.suffix.lower() != ".bin" or sysdef["folder"] == "megadrive"]
    return [p for p in files if p.resolve() not in hidden]


# ---------------------------------------------------------------- budget
def budget_cap():
    if BUDGET_FILE.exists(): return json.loads(BUDGET_FILE.read_text())
    return None


def library_bytes():
    return du(ROMS) + sum(du(THUMBS / s["db"]) for s in SYSTEMS)


def dolphin_sys():
    """The libretro Dolphin core needs Dolphin's own Sys data folder (game settings, open-source code handler) in
    bios/dolphin-emu/Sys; Arch's package doesn't ship it. Fetch it from the core's exact git commit."""
    dest = BIOS / "dolphin-emu" / "Sys"
    if (dest / "codehandler.bin").exists() or not (CORES / "dolphin_libretro.so").exists(): return
    ver = subprocess.run(["pacman", "-Q", "libretro-dolphin"], capture_output=True, text=True).stdout.split()
    commit = re.search(r"\.g([0-9a-f]{7,40})", ver[1]).group(1) if len(ver) > 1 and re.search(r"\.g([0-9a-f]{7,40})", ver[1]) else "master"
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        git = lambda *a: subprocess.run(["git", "-C", tmp, *a], check=True, capture_output=True)
        subprocess.run(["git", "clone", "-q", "--filter=blob:none", "--no-checkout", "https://github.com/libretro/dolphin", tmp], check=True, capture_output=True)
        git("sparse-checkout", "set", "--no-cone", "/Data/Sys"); git("checkout", "-q", commit)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(Path(tmp) / "Data" / "Sys", dest, dirs_exist_ok=True)
    print(f"Installed Dolphin's Sys folder (libretro/dolphin {commit[:10]}) for GameCube.")


def cmd_init():
    for s in SYSTEMS: (ROMS / s["folder"]).mkdir(parents=True, exist_ok=True)
    BIOS.mkdir(parents=True, exist_ok=True)
    try: dolphin_sys()
    except Exception as e: print(f"Could not fetch Dolphin's Sys folder ({e}); GameCube games won't start until it's in {BIOS}/dolphin-emu/Sys.")
    if not budget_cap():
        free = shutil.disk_usage(GAMES).free
        cap = (free + library_bytes()) // 2
        BUDGET_FILE.write_text(json.dumps({"cap_bytes": cap, "rule": "half of the free disk when the library was set up",
                                           "set_on": subprocess.run(["date", "+%F"], capture_output=True, text=True).stdout.strip()}))
    c = budget_cap()
    print(f"Folders ready in {ROMS}. Budget: {c['cap_bytes'] / GB:.0f} GB ({c['rule']}, {c['set_on']}).")


def plan_rows():
    rows = []
    for s in SYSTEMS:
        g = games_in(s)
        used = du(ROMS / s["folder"])
        rows.append({"folder": s["folder"], "name": s["name"], "tier": s["tier"], "games": len(g), "target": s["target"],
                     "used": used, "alloc": s["target"] * s["gb_each"] * GB})
    return rows


def status():
    rows, cap = plan_rows(), budget_cap()
    art = sum(du(THUMBS / s["db"]) for s in SYSTEMS)
    used = sum(r["used"] for r in rows) + art
    plan = sum(r["alloc"] for r in rows) + PLAN["art"]["gb_reserved"] * GB
    return {"cap": cap["cap_bytes"] if cap else None, "used": used, "art": art, "plan": plan, "rows": rows,
            "games": sum(r["games"] for r in rows), "bios": bios_report()}


def human(b):
    return f"{b / GB:.1f} GB" if b >= GB else f"{b / 1e6:.0f} MB" if b >= 1e6 else f"{b / 1e3:.0f} KB"


def cmd_budget():
    st = status()
    print(f"{'System':30} {'tier':8} {'games':>11} {'used':>9} {'planned':>9}")
    for r in st["rows"]:
        flag = "  ← over plan" if r["used"] > r["alloc"] * 1.15 and r["used"] > 50e6 else ""
        print(f"{r['name']:30} {r['tier']:8} {r['games']:>5}/{r['target']:<5} {human(r['used']):>9} {human(r['alloc']):>9}{flag}")
    print(f"{'Art (box, snaps, titles)':30} {'':8} {'':>11} {human(st['art']):>9} {human(PLAN['art']['gb_reserved'] * GB):>9}")
    if st["cap"] is None:
        print("\nNo budget yet: run `kit-games init`."); return 0
    pct = 100 * st["used"] / st["cap"]
    print(f"\nLibrary: {human(st['used'])} of {human(st['cap'])} budget ({pct:.1f}%). Plan totals {human(st['plan'])}.")
    if st["used"] > st["cap"]:
        print("OVER BUDGET: remove games (or art) until the library fits."); return 1
    return 0


# ---------------------------------------------------------------- playlists
def cmd_scan():
    PLAYLISTS.mkdir(parents=True, exist_ok=True)
    made = 0
    for s in SYSTEMS:
        core_path = CORES / f"{s['core']}_libretro.so"
        core_name = info(s["core"]).get("corename", s["core"])
        lpl = PLAYLISTS / f"{s['db']}.lpl"
        files = games_in(s)
        if not files:
            continue
        if s.get("arcade"):  # arcade sets have short names (sf2.zip): let RetroArch's scanner find the real titles
            subprocess.run(["retroarch", f"--scan={ROMS / s['folder']}"], capture_output=True, timeout=600)
            data = json.loads(lpl.read_text()) if lpl.exists() else {"version": "1.5", "items": []}
            labels = json.loads((ROMS / s["folder"] / "labels.json").read_text()) if (ROMS / s["folder"] / "labels.json").exists() else {}
            for i in data["items"]:  # short set names (circus.zip) get their real title when the folder provides one
                i["label"] = labels.get(Path(i["path"]).stem, i["label"])
            known = {i["path"] for i in data["items"]}
            for f in files:  # anything the database didn't recognise still gets an entry
                if str(f) not in known:
                    data["items"].append({"path": str(f), "label": labels.get(f.stem, f.stem), "core_path": "DETECT", "core_name": "DETECT", "crc32": "DETECT", "db_name": lpl.name})
        else:
            data = {"version": "1.5", "items": [{"path": str(f), "label": f.parent.name if f.suffix == ".scummvm" else f.stem, "core_path": "DETECT", "core_name": "DETECT",
                                                  "crc32": "DETECT", "db_name": lpl.name} for f in files]}
        data.update({"default_core_path": str(core_path), "default_core_name": core_name, "label_display_mode": 0,
                     "right_thumbnail_mode": 0, "left_thumbnail_mode": 0, "sort_mode": 0,
                     "scan_content_dir": str(ROMS / s["folder"]), "scan_file_exts": "|".join(s["exts"]),
                     "scan_search_recursively": True, "scan_search_archives": False, "scan_filter_dat_content": False})
        data["items"].sort(key=lambda i: i["label"].lower())
        lpl.write_text(json.dumps(data, indent=2, ensure_ascii=False))
        made += 1
        print(f"{s['name']:30} {len(data['items']):>4} games → {core_name}")
    print(f"{made} playlists in {PLAYLISTS}")
    quiet_export()
    return cmd_budget_quiet()


def quiet_export():
    """Keep ~/Games/telesia/library.json in step with the playlists (writing a file only; never uploads)."""
    import contextlib, io
    with contextlib.redirect_stdout(io.StringIO()):
        try: cmd_export_telesia(upload=False)
        except Exception: pass


def cmd_budget_quiet():
    st = status()
    if st["cap"] and st["used"] > st["cap"]:
        print(f"WARNING: library is {human(st['used'])}, over the {human(st['cap'])} budget. Run `kit-games budget`.")
        return 1
    return 0


# ---------------------------------------------------------------- art
def thumb_name(label):
    return re.sub(r'[&*/:`<>?\\|"]', "_", label)


def cmd_art():
    cap = budget_cap()
    reserve = PLAN["art"]["gb_reserved"] * GB
    missing = set(json.loads(MISSING_ART.read_text())) if MISSING_ART.exists() else set()
    jobs = []
    for s in SYSTEMS:
        lpl = PLAYLISTS / f"{s['db']}.lpl"
        if not lpl.exists(): continue
        for item in json.loads(lpl.read_text())["items"]:
            for kind in PLAN["art"]["types"]:
                name = thumb_name(item["label"]) + ".png"
                dest = THUMBS / s["db"] / kind / name
                url = "https://thumbnails.libretro.com/" + "/".join(urllib.parse.quote(x) for x in (s["db"], kind, name))
                if not dest.exists() and url not in missing: jobs.append((url, dest))

    def fetch(job):
        url, dest = job
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "omarchy-kit"}), timeout=20) as r:
                data = r.read()
            dest.parent.mkdir(parents=True, exist_ok=True); dest.write_bytes(data)
            return url, len(data)
        except Exception:
            return url, None

    got = miss = 0
    art_now = sum(du(THUMBS / s["db"]) for s in SYSTEMS)
    with ThreadPoolExecutor(8) as ex:
        for url, size in ex.map(fetch, jobs):
            if size is None: missing.add(url); miss += 1
            else: got += 1; art_now += size
            if art_now > reserve:
                print("Art reached its reserved space; stopping."); break
    MISSING_ART.write_text(json.dumps(sorted(missing)))
    print(f"Art: {got} downloaded, {miss} not on the libretro server (name the file the No-Intro/Redump way to match).")
    return cmd_budget_quiet()


# ---------------------------------------------------------------- ingest (your own dumps)
INBOX = GAMES / "inbox"
INGEST_LOG = GAMES / ".kit-ingest.json"
DISC_SRC = {".cue", ".gdi", ".iso", ".toc"}


def ra_scan(folder, tmp):
    """Identify files with RetroArch's own scanner (CRC for cartridges, serial for discs) into a scratch
    playlist directory. A throwaway config with config_save_on_exit off, so the real one is never touched."""
    cfg = tmp / "scan.cfg"
    cfg.write_text(f'config_save_on_exit = "false"\nplaylist_directory = "{tmp / "pl"}"\n'
                   f'content_database_path = "/usr/share/libretro/database/rdb"\nlibretro_info_path = "{INFO}"\n'
                   f'libretro_directory = "{CORES}"\nlog_verbosity = "false"\n')
    (tmp / "pl").mkdir(exist_ok=True)
    subprocess.run(["retroarch", f"--config={cfg}", f"--scan={folder}"], capture_output=True, timeout=1800)
    found = {}
    for lpl in (tmp / "pl").glob("*.lpl"):
        if lpl.stem in ("content_history", "content_favorites"): continue
        for item in json.loads(lpl.read_text()).get("items", []):
            found[Path(item["path"].split("#")[0]).resolve()] = (item["label"], lpl.stem)
    return found


def disc_members(src):
    """The files a .cue/.gdi sheet names (its .bin/.raw tracks), so they move together."""
    out = []
    if src.suffix.lower() in (".cue", ".gdi"):
        for line in src.read_text(errors="ignore").splitlines():
            m = re.search(r'FILE\s+"([^"]+)"', line) or (re.match(r"\s*\d+\s+\d+\s+\d+\s+\d+\s+(\S+)", line) if src.suffix.lower() == ".gdi" else None)
            if m and (src.parent / m[1]).exists(): out.append(src.parent / m[1])
    return out


def cmd_ingest():
    import tempfile
    INBOX.mkdir(parents=True, exist_ok=True)
    files = [p for p in INBOX.rglob("*") if p.is_file() and not p.name.startswith(".")]
    if not files:
        print(f"Nothing to ingest. Put your dumps in {INBOX} and run this again."); return 0
    by_db = {s["db"]: s for s in SYSTEMS}
    log = json.loads(INGEST_LOG.read_text()) if INGEST_LOG.exists() else []
    cap = (budget_cap() or {}).get("cap_bytes")
    moved = unknown = 0
    with tempfile.TemporaryDirectory() as t:
        found = ra_scan(INBOX, Path(t))
        claimed = set()
        for path, (label, db) in sorted(found.items(), key=lambda kv: str(kv[0])):
            if path in claimed or not path.exists(): continue
            sysdef = by_db.get(db)
            if not sysdef:
                print(f"? {path.name}: identified as {db}, which this library has no folder for"); continue
            members = disc_members(path)
            size = sum(f.stat().st_size for f in [path, *members])
            if cap and library_bytes() + size > cap:
                print(f"! {label}: would exceed the {cap / GB:.0f} GB budget; left in the inbox"); continue
            dest_dir = ROMS / sysdef["folder"]; dest_dir.mkdir(parents=True, exist_ok=True)
            name = thumb_name(label)
            ext = path.suffix.lower()
            if ext in DISC_SRC and sysdef["folder"] == "gc" and shutil.which("dolphin-tool"):
                out = dest_dir / f"{name}.rvz"
                r = subprocess.run(["dolphin-tool", "convert", "-f", "rvz", "-b", "131072", "-c", "zstd", "-l", "5",
                                    "-i", str(path), "-o", str(out)], capture_output=True, text=True)
                ok = r.returncode == 0
            elif ext in DISC_SRC and sysdef["folder"] != "gc" and shutil.which("chdman"):
                out = dest_dir / f"{name}.chd"
                mode = "createdvd" if ext == ".iso" and sysdef["folder"] in ("psp",) else "createcd"
                r = subprocess.run(["chdman", mode, "-i", str(path), "-o", str(out), "-f"], capture_output=True, text=True)
                ok = r.returncode == 0
            else:  # cartridges, or discs while the converters are not installed: move as they are
                out = dest_dir / f"{name}{ext}"
                for m in members: shutil.move(str(m), str(dest_dir / m.name))
                shutil.move(str(path), str(out)); ok = True
            if not ok:
                print(f"! {label}: conversion failed, left in the inbox ({(r.stderr or r.stdout).strip()[-200:]})"); continue
            if out.suffix in (".chd", ".rvz"):
                for f in [path, *members]: f.unlink(missing_ok=True)
            claimed.update([path, *members])
            log.append({"file": str(out), "label": label, "db": db, "from": path.name,
                        "date": subprocess.run(["date", "-Iseconds"], capture_output=True, text=True).stdout.strip()})
            moved += 1
            print(f"✓ {label} → {sysdef['folder']}/{out.name}")
    leftovers = [p for p in INBOX.rglob("*") if p.is_file() and not p.name.startswith(".")]
    for p in leftovers:
        if p.suffix.lower() in (".bin", ".raw") : continue  # tracks of a sheet that wasn't identified are reported via the sheet
        unknown += 1
        print(f"? {p.name}: not in libretro's databases. A bad or modified dump, a homebrew, or an unsupported format.")
    INGEST_LOG.write_text(json.dumps(log, indent=1, ensure_ascii=False))
    print(f"\nIngested {moved}; {unknown} left in {INBOX} for a look.")
    if moved:
        cmd_scan(); cmd_art()
    return 0


# ---------------------------------------------------------------- Telesia export
TELESIA_OUT = GAMES / "telesia" / "library.json"
TAGS = re.compile(r"\s*[\(\[][^\)\]]*[\)\]]\s*$")


def clean_title(label):
    """No-Intro/Redump dump names end in tag groups: "Super Metroid (Japan, USA) (En,Ja)". This library names
    its files that way on purpose, so it is this side's job (not Telesia's) to send the title without them."""
    prev = None
    while prev != label:
        prev, label = label, TAGS.sub("", label)
    return label.strip()


def runtimes():
    """RetroArch's per-game runtime logs: logs/<core>/<content>.lrtl with runtime "H:MM:SS" and a local
    last_played "YYYY-MM-DD HH:MM:SS". Keyed by content file name without extension."""
    out = {}
    for f in (PLAYLISTS / "logs").rglob("*.lrtl"):
        try: d = json.loads(f.read_text())
        except Exception: continue
        h, m, sec = (int(x) for x in d.get("runtime", "0:00:00").split(":"))
        minutes = h * 60 + m + sec / 60
        lp = d.get("last_played", "")
        key = f.stem
        prev = out.get(key)
        if prev is None or minutes > prev[0]: out[key] = (minutes, lp)
    return out


def cmd_export_telesia(upload=None):
    from datetime import datetime
    rt = runtimes()
    offset = datetime.now().astimezone().strftime("%z")
    offset = offset[:3] + ":" + offset[3:]
    items = []
    for s in SYSTEMS:
        lpl = PLAYLISTS / f"{s['db']}.lpl"
        if not lpl.exists(): continue
        for it in json.loads(lpl.read_text())["items"]:
            stem = Path(it["path"]).stem
            row = {"label": clean_title(it["label"]), "db_name": f"{s['db']}.lpl", "core_name": info(s["core"]).get("corename", s["core"]),
                   "core_path": it.get("core_path", "DETECT"), "crc32": it.get("crc32", "DETECT")}
            if stem in rt:
                minutes, lp = rt[stem]
                row["playtime_minutes"] = round(minutes)
                if re.match(r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$", lp): row["last_played"] = lp.replace(" ", "T") + offset
            items.append(row)
    TELESIA_OUT.parent.mkdir(parents=True, exist_ok=True)
    TELESIA_OUT.write_text(json.dumps(items, indent=1, ensure_ascii=False))
    played = sum(1 for i in items if i.get("playtime_minutes"))
    print(f"Wrote {len(items)} titles ({played} with playtime) to {TELESIA_OUT}")
    if (("--upload" in sys.argv) if upload is None else upload):
        token, api = os.environ.get("TELESIA_TOKEN"), os.environ.get("TELESIA_API", "https://api.telesia.quest")
        if not token:
            print("Not uploaded: set TELESIA_TOKEN to a Janua access token for your Telesia account."); return 1
        req = urllib.request.Request(f"{api}/v1/library/import/export?provider=OTHER", data=TELESIA_OUT.read_bytes(), method="POST",
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "omarchy-kit"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                print(f"Telesia answered {r.status}: {r.read().decode()[:400]}")
        except urllib.error.HTTPError as e:
            print(f"Telesia answered {e.code}: {e.read().decode()[:400]}"); return 1
    return 0


