def collection_name(sysdef):
    return re.sub(r"[/\\:]+", "-", sysdef["name"]).replace("  ", " ").strip()


def cmd_cabinet():
    if not (RETROFE_HOME / "layouts").exists():
        print("RetroFE is not installed yet: run `yay -S retrofe`, then `kit-games cabinet` again.")
    CABINET.mkdir(parents=True, exist_ok=True)
    if (CABINET / "meta").is_symlink(): (CABINET / "meta").unlink()
    for d in ("collections", "launchers", "meta/hyperlist"): (CABINET / d).mkdir(parents=True, exist_ok=True)
    layouts = CABINET / "layouts"
    if (RETROFE_HOME / "layouts").exists() and not layouts.exists(): layouts.symlink_to(RETROFE_HOME / "layouts")
    from xml.sax.saxutils import escape, quoteattr
    (CABINET / "settings.conf").write_text("".join(f"{k} = {v}\n" for k, v in CABINET_SETTINGS.items()))
    (CABINET / "controls.conf").write_text("".join(f"{k} = {v}\n" for k, v in CABINET_CONTROLS.items()))
    menu = []
    for sysdef in SYSTEMS:
        games = games_in(sysdef)
        if not games: continue
        name = collection_name(sysdef)
        col = CABINET / "collections" / name
        if col.exists(): shutil.rmtree(col)
        col.mkdir(parents=True)
        (CABINET / "launchers" / f"{sysdef['core']}.conf").write_text(
            f"executable = /usr/bin/retroarch\narguments = -L {CORES}/{sysdef['core']}_libretro.so \"%ITEM_FILEPATH%\"\n")
        # artwork per collection, named the way RetroFE looks it up (the item name = the file name without extension)
        lpl = PLAYLISTS / f"{sysdef['db']}.lpl"
        labels = {Path(i["path"]).stem: i["label"] for i in json.loads(lpl.read_text())["items"]} if lpl.exists() else {}
        media = {"artwork_front": "Named_Boxarts", "screenshot": "Named_Snaps", "screentitle": "Named_Titles"}
        for kind, folder in media.items():
            out = col / "medium_artwork" / kind; out.mkdir(parents=True)
            for g in games:
                src = THUMBS / sysdef["db"] / folder / f"{thumb_name(labels.get(g.stem, g.stem))}.png"
                if src.exists(): (out / f"{g.stem}.png").symlink_to(src)
        exts = sorted({g.suffix.lstrip(".").lower() for g in games})
        (col / "settings.conf").write_text(
            f"list.path = {ROMS / sysdef['folder']}\nlist.includeMissingItems = false\nlist.extensions = {','.join(exts)}\n"
            f"list.menuSort = true\nlauncher = {sysdef['core']}\n"
            + "".join(f"media.{k} = {col / 'medium_artwork' / k}\n" for k in media))
        if sysdef["folder"] == "scummvm":  # games are folders; romHierarchy makes RetroFE descend into them
            with (col / "settings.conf").open("a") as f: f.write("list.romHierarchy = true\n")
        # titles: RetroFE reads meta/hyperlist/<collection>.xml (HyperSpin format) into its meta.db; without one it
        # would show file names ("circus", "sky"). name = file name without extension, description = playlist title.
        rows = "".join(f"  <game name={quoteattr(g.stem)}><description>{escape(labels.get(g.stem, g.stem))}</description></game>\n" for g in games)
        (CABINET / "meta" / "hyperlist" / f"{name}.xml").write_text(f"<?xml version=\"1.0\"?>\n<menu>\n{rows}</menu>\n")
        (CABINET / "meta.db").unlink(missing_ok=True)  # rebuilt by RetroFE on its next start
        menu.append(name)
    main = CABINET / "collections" / "Main"; main.mkdir(exist_ok=True)
    (main / "settings.conf").write_text("list.extensions = sh\nlist.menuSort = no\nlauncher = Main\n")
    (main / "menu.txt").write_text("\n".join(menu) + "\n")
    (CABINET / "launchers" / "Main.conf").write_text("executable = /bin/true\n")
    # KNOWN ISSUE (2026-10-05): RetroFE 0.10.31 draws only a black window on this machine (Hyprland, Mesa 26,
    # Iris Pro), its own sample config included, windowed or fullscreen, with SDL on wayland/x11 and the
    # opengl/software renderers. So no launcher entry is written unless asked for with --desktop.
    if "--desktop" not in sys.argv:
        print(f"Cabinet: {len(menu)} collections in {CABINET} (no launcher entry: RetroFE renders black here; see kit-games source).")
        return 0
    desktop = Path.home() / ".local/share/applications/retro-cabinet.desktop"
    desktop.parent.mkdir(parents=True, exist_ok=True)
    desktop.write_text("[Desktop Entry]\nType=Application\nName=Retro Cabinet\nComment=Arcade-cabinet frontend (RetroFE) over your game library\n"
                       f"Exec=env RETROFE_PATH={CABINET} {RETROFE_BIN}\nIcon=retro-gaming\nCategories=Game;Emulator;\nTerminal=false\n")
    print(f"Cabinet: {len(menu)} collections in {CABINET}. Start it from the launcher as 'Retro Cabinet' "
          f"(or: RETROFE_PATH={CABINET} retrofe).")
    return 0


