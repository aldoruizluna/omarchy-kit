def collection_name(sysdef):
    return re.sub(r"[/\\:]+", "-", sysdef["name"]).replace("  ", " ").strip()


def cmd_cabinet():
    if not (RETROFE_HOME / "layouts").exists():
        print("RetroFE is not installed yet: run `yay -S retrofe`, then `kit-games cabinet` again.")
    CABINET.mkdir(parents=True, exist_ok=True)
    if (CABINET / "meta").is_symlink(): (CABINET / "meta").unlink()
    for d in ("collections", "launchers", "meta/hyperlist"): (CABINET / d).mkdir(parents=True, exist_ok=True)
    layouts = CABINET / "layouts"
    if (RETROFE_HOME / "layouts").exists() and not layouts.exists(): layouts.symlink_to(RETROFE_HOME / "layouts")
    from xml.sax.saxutils import escape, quoteattr
    (CABINET / "settings.conf").write_text("".join(f"{k} = {v}\n" for k, v in CABINET_SETTINGS.items()))
    (CABINET / "controls.conf").write_text("".join(f"{k} = {v}\n" for k, v in CABINET_CONTROLS.items()))
    menu = []
    for sysdef in SYSTEMS:
        games = games_in(sysdef)
        if not games: continue
        name = collection_name(sysdef)
        col = CABINET / "collections" / name
        if col.exists(): shutil.rmtree(col)
        col.mkdir(parents=True)
        (CABINET / "launchers" / f"{sysdef['core']}.conf").write_text(
            f"executable = /usr/bin/retroarch\narguments = -L {CORES}/{sysdef['core']}_libretro.so \"%ITEM_FILEPATH%\"\n")
        # artwork per collection, named the way RetroFE looks it up (the item name = the file name without extension)
        lpl = PLAYLISTS / f"{sysdef['db']}.lpl"
        labels = {Path(i["path"]).stem: i["label"] for i in json.loads(lpl.read_text())["items"]} if lpl.exists() else {}
        media = {"artwork_front": "Named_Boxarts", "screenshot": "Named_Snaps", "screentitle": "Named_Titles"}
        for kind, folder in media.items():
            out = col / "medium_artwork" / kind; out.mkdir(parents=True)
            for g in games:
                src = THUMBS / sysdef["db"] / folder / f"{thumb_name(labels.get(g.stem, g.stem))}.png"
                if src.exists(): (out / f"{g.stem}.png").symlink_to(src)
        exts = sorted({g.suffix.lstrip(".").lower() for g in games})
        (col / "settings.conf").write_text(
            f"list.path = {ROMS / sysdef['folder']}\nlist.includeMissingItems = false\nlist.extensions = {','.join(exts)}\n"
            f"list.menuSort = true\nlauncher = {sysdef['core']}\n"
            + "".join(f"media.{k} = {col / 'medium_artwork' / k}\n" for k in media))
        if sysdef["folder"] == "scummvm":  # games are folders; romHierarchy makes RetroFE descend into them
            with (col / "settings.conf").open("a") as f: f.write("list.romHierarchy = true\n")
        # titles: RetroFE reads meta/hyperlist/<collection>.xml (HyperSpin format) into its meta.db; without one it
        # would show file names ("circus", "sky"). name = file name without extension, description = playlist title.
        rows = "".join(f"  <game name={quoteattr(g.stem)}><description>{escape(labels.get(g.stem, g.stem))}</description></game>\n" for g in games)
        (CABINET / "meta" / "hyperlist" / f"{name}.xml").write_text(f"<?xml version=\"1.0\"?>\n<menu>\n{rows}</menu>\n")
        (CABINET / "meta.db").unlink(missing_ok=True)  # rebuilt by RetroFE on its next start
        menu.append(name)
    main = CABINET / "collections" / "Main"; main.mkdir(exist_ok=True)
    (main / "settings.conf").write_text("list.extensions = sh\nlist.menuSort = no\nlauncher = Main\n")
    (main / "menu.txt").write_text("\n".join(menu) + "\n")
    (CABINET / "launchers" / "Main.conf").write_text("executable = /bin/true\n")
    # KNOWN ISSUE (2026-10-05): RetroFE 0.10.31 draws only a black window on this machine (Hyprland, Mesa 26,
    # Iris Pro), its own sample config included, windowed or fullscreen, with SDL on wayland/x11 and the
    # opengl/software renderers. So no launcher entry is written unless asked for with --desktop.
    if "--desktop" not in sys.argv:
        print(f"Cabinet: {len(menu)} collections in {CABINET} (no launcher entry: RetroFE renders black here; see kit-games source).")
        return 0
    desktop = Path.home() / ".local/share/applications/retro-cabinet.desktop"
    desktop.parent.mkdir(parents=True, exist_ok=True)
    desktop.write_text("[Desktop Entry]\nType=Application\nName=Retro Cabinet\nComment=Arcade-cabinet frontend (RetroFE) over your game library\n"
                       f"Exec=env RETROFE_PATH={CABINET} {RETROFE_BIN}\nIcon=retro-gaming\nCategories=Game;Emulator;\nTerminal=false\n")
    print(f"Cabinet: {len(menu)} collections in {CABINET}. Start it from the launcher as 'Retro Cabinet' "
          f"(or: RETROFE_PATH={CABINET} retrofe).")
    return 0


# ---------------------------------------------------------------- ES-DE
ESDE = Path.home() / "ES-DE"
ESDE_APPIMAGE = Path.home() / ".local/opt/es-de/ES-DE_x64.AppImage"
# Where ES-DE's default core for a system differs from the one this library runs (labels exactly as in ES-DE
# 3.5.0's resources/systems/linux/es_systems.xml). ES-DE stores the choice as <alternativeEmulator> in gamelist.xml.
ESDE_ALT = {"psx": "Beetle PSX HW", "saturn": "Kronos", "pcengine": "Beetle PCE FAST", "pcenginecd": "Beetle PCE FAST",
            "arcade": "FinalBurn Neo"}
ESDE_MEDIA = {"covers": "Named_Boxarts", "screenshots": "Named_Snaps", "titlescreens": "Named_Titles"}


def homebrew_details():
    """Developer and description per installed homebrew file, from Homebrew Hub's cached entries."""
    out = {}
    man = GAMES / ".kit-homebrew.json"
    if not man.exists(): return out
    entries = {}
    for f in (GAMES / ".cache").glob("homebrew-hub-*.json"):
        for e in json.loads(f.read_text()): entries[e.get("slug")] = e
    for slug, m in json.loads(man.read_text()).items():
        e = entries.get(slug, {})
        out[Path(m["file"]).name] = {"developer": ", ".join(m.get("developer") or []),
                                     "desc": (e.get("description") or "").strip()}
    return out


def esde_settings(values):
    import xml.etree.ElementTree as ET
    path = ESDE / "settings" / "es_settings.xml"
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.exists() else ['<?xml version="1.0"?>']
    out, seen = [], set()
    for line in lines:
        m = re.search(r'name="([^"]+)"', line)
        if m and m[1] in values:
            out.append(re.sub(r'value="[^"]*"', f'value={json.dumps(values[m[1]])}', line)); seen.add(m[1])
        else:
            out.append(line)
    for k, v in values.items():
        if k not in seen: out.append(f'<string name="{k}" value={json.dumps(v)} />')
    path.write_text("\n".join(out) + "\n")


def cmd_esde():
    import xml.etree.ElementTree as ET
    esde_settings({"ROMDirectory": str(ROMS), "MediaDirectory": str(ESDE / "downloaded_media")})
    details = homebrew_details()
    systems = 0
    for sysdef in SYSTEMS:
        games = games_in(sysdef)
        if not games: continue
        systems += 1
        folder, base = sysdef["folder"], ROMS / sysdef["folder"]
        lpl = PLAYLISTS / f"{sysdef['db']}.lpl"
        labels = {Path(i["path"]).resolve(): i["label"] for i in json.loads(lpl.read_text())["items"]} if lpl.exists() else {}
        gl = ESDE / "gamelists" / folder / "gamelist.xml"
        gl.parent.mkdir(parents=True, exist_ok=True)
        root = ET.parse(gl).getroot() if gl.exists() else ET.Element("gameList")
        alt = root.find("alternativeEmulator")
        if folder in ESDE_ALT:
            if alt is None:
                alt = ET.Element("alternativeEmulator"); root.insert(0, alt)
            lab = alt.find("label") if alt.find("label") is not None else ET.SubElement(alt, "label")
            lab.text = ESDE_ALT[folder]
        by_path = {g.findtext("path"): g for g in root.findall("game")}
        for g in games:
            rel = "./" + str(g.relative_to(base))
            node = by_path.get(rel)
            if node is None:
                node = ET.SubElement(root, "game"); ET.SubElement(node, "path").text = rel
            label = labels.get(g.resolve(), g.parent.name if g.suffix == ".scummvm" else g.stem)
            (node.find("name") if node.find("name") is not None else ET.SubElement(node, "name")).text = clean_title(label) or label
            d = details.get(g.name)
            if d:
                for key in ("developer", "desc"):
                    if d[key] and node.find(key) is None: ET.SubElement(node, key).text = d[key]
            # media: ES-DE looks for <media>/<system>/<type>/<path relative to the system folder, no extension>.png
            for kind, src_kind in ESDE_MEDIA.items():
                src = THUMBS / sysdef["db"] / src_kind / f"{thumb_name(label)}.png"
                dst = ESDE / "downloaded_media" / folder / kind / g.relative_to(base).with_suffix(".png")
                if src.exists() and not dst.exists():
                    dst.parent.mkdir(parents=True, exist_ok=True); dst.symlink_to(src)
        ET.indent(root)
        gl.write_text('<?xml version="1.0"?>\n' + ET.tostring(root, encoding="unicode") + "\n")
    desktop = Path.home() / ".local/share/applications/es-de.desktop"
    if ESDE_APPIMAGE.exists():
        desktop.write_text("[Desktop Entry]\nType=Application\nName=ES-DE\nGenericName=Game library\n"
                           "Comment=EmulationStation Desktop Edition over your retro library\n"
                           f"Exec={ESDE_APPIMAGE}\nIcon=retro-gaming\nCategories=Game;Emulator;\nTerminal=false\n")
    print(f"ES-DE: {systems} systems configured in {ESDE} (ROMs: {ROMS})." +
          ("" if ESDE_APPIMAGE.exists() else f" Install the AppImage at {ESDE_APPIMAGE} to get a launcher entry."))
    return 0


# ---------------------------------------------------------------- BIOS
def bios_report():
    """One row per console from systems.toml [[bios]]; a row is satisfied when any of its files exists."""
    out = []
    for b in PLAN.get("bios", []):
        found = next((f for f in b["any"] if (BIOS / f).exists()), None)
        out.append({"system": b["system"], "file": found or b["any"][0], "alternatives": [f for f in b["any"] if not f.startswith("..")],
                    "desc": b["note"], "need": b["need"], "optional": b["need"] == "optional", "present": bool(found)})
    return out


def cmd_bios():
    have = 0
    for b in bios_report():
        mark = "✓" if b["present"] else ("·" if b["optional"] else "✗")
        have += b["present"]
        files = b["file"] if b["present"] else " or ".join(b["alternatives"])
        print(f"{mark} {b['system']:30} {b['need']:11} {files}\n  {'':30} {b['desc']}")
    print(f"\n✓ present  ✗ needed, missing  · optional, missing. Put BIOS files in {BIOS}.")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "budget"
    if cmd == "status": print(json.dumps(status())); return 0
    fn = {"init": cmd_init, "scan": cmd_scan, "art": cmd_art, "budget": cmd_budget, "bios": cmd_bios,
          "ingest": cmd_ingest, "export-telesia": cmd_export_telesia, "cabinet": cmd_cabinet, "esde": cmd_esde}.get(cmd)
    if not fn: print(__doc__); return 2
    return fn() or 0


if __name__ == "__main__":
    sys.exit(main())
