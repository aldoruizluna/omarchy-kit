def cmd_dolphin():
    import configparser, datetime
    stamp = datetime.date.today().isoformat()
    DOLPHIN_CFG.mkdir(parents=True, exist_ok=True)
    for name, sections in DOLPHIN_INI.items():
        path = DOLPHIN_CFG / name
        bak = path.with_name(f"{name}.bak-{stamp}")
        if path.exists() and not bak.exists(): shutil.copy2(path, bak)
        ini = configparser.ConfigParser(interpolation=None, strict=False); ini.optionxform = str
        if path.exists(): ini.read(path)
        for sec, kv in sections.items():
            if not ini.has_section(sec): ini.add_section(sec)
            for k, v in kv.items(): ini.set(sec, k, v)
        with path.open("w") as f: ini.write(f, space_around_delimiters=True)
    # memory cards and states live with the rest of the saves (~/Games), so one folder backs up / syncs everything
    for sub, home in (("GC", GAMES / "saves/dolphin-standalone/GC"), ("StateSaves", GAMES / "states/dolphin-standalone")):
        link = DOLPHIN_DATA / sub
        home.mkdir(parents=True, exist_ok=True)
        if link.is_symlink() or not link.exists():
            if link.is_symlink(): link.unlink()
            link.parent.mkdir(parents=True, exist_ok=True); link.symlink_to(home)
        elif link.resolve() != home.resolve():
            print(f"Left {link} alone (a real folder); move it into {home} and re-run to keep saves in ~/Games.")
    cmd_esde()   # its gamelist pins GameCube to "Dolphin (Standalone)" (ESDE_ALT)
    tool = "" if shutil.which("dolphin-tool") else " dolphin-tool is missing, so ingest keeps GameCube dumps as ISO (install: sudo pacman -S dolphin-emu-tool)."
    print(f"Dolphin configured in {DOLPHIN_CFG}: OpenGL, 2x (1280x1056), hybrid ubershaders, VSync; "
          f"PS4 controller + keyboard on port 1; saves in {GAMES}/saves/dolphin-standalone.{tool}")
    return 0


